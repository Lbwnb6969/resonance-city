static func chord_guide()->String:
	var lines:PackedStringArray=[]
	for chord:String in Synergy.CHORD_NAMES:lines.append("  - "+str(Synergy.CHORD_NAMES[chord])+"："+str(Synergy.CHORD_DETAILS[chord]))
	return "\n".join(lines)
