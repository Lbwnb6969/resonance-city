import os
import sys
from pathlib import Path

sdk = ARGUMENTS.pop("sdk", "../../.git/原生构建/godot-cpp")
# Python's rmtree/mkdir round trip through a Windows directory junction leaves
# the generated directory unavailable. Resolve only the generator output;
# SCons/MSVC keep the ASCII junction paths for sources and response files.
sys.path.insert(0, os.path.abspath(sdk))
import binding_generator
original_generate_bindings = binding_generator._generate_bindings
def generate_bindings_at_real_path(api, api_filepath, use_template_get_node, bits="64", precision="single", output_dir="."):
    return original_generate_bindings(api, api_filepath, use_template_get_node, bits, precision, str(Path(output_dir).resolve()))
binding_generator._generate_bindings = generate_bindings_at_real_path
env = SConscript(os.path.join(sdk, "SConstruct"))
env.Append(CPPPATH=["src"])
library = env.SharedLibrary("../../addons/city_audio/bin/city_audio" + env["suffix"] + env["SHLIBSUFFIX"], source=Glob("src/*.cpp"))
env.NoCache(library)
Default(library)
