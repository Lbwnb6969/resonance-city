func author_form():return demo.gallery.authorship.ui
func type_line(control:LineEdit,text:String)->void:
	await ui_click(control);control.select_all()
	for i in range(text.length()):
		for down:bool in [true,false]:
			var event:=InputEventKey.new();event.device=92;event.unicode=text.unicode_at(i);event.pressed=down;root.push_input(event);await process_frame
func gallery_reveal(control:Control)->void:
	var parent:Node=control.get_parent()
	while parent!=null:
		if parent is ScrollContainer:parent.ensure_control_visible(control);await process_frame
		parent=parent.get_parent()
	await settle()
func open_gallery()->void:
	demo.gallery.open_panel();await settle();quiet()
func native_save(title:String,note:String)->String:
	await open_gallery();await type_line(demo.gallery.panel.title_input,title);await type_line(author_form().note,note);check(demo.gallery.panel.title_input.text==title and author_form().note.text==note,"real native title and Unicode author-note inputs accept the intended text")
	var old:String=demo.gallery.last_saved_id;await ui_click(demo.gallery.panel.save_button);check(await wait_for(func():return not demo.gallery.busy and demo.gallery.last_saved_id!=old,8000),"real original save button publishes a distinct immutable version");return demo.gallery.last_saved_id
func has_memory(kind:String)->bool:return demo.gallery.authorship.chronicle.rows().any(func(row):return row.kind==kind)
