extends "res://tools/check_creation_functional_zones_live.gd"
const ContractFixture=preload("res://tools/fixtures/city_creation_space_contract_fixture.gd")
func run()->void:
	OUT="res://验证记录/M84/courtyard_contract_20261029/live"
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(OUT));root.size=Vector2i(1440,900);Engine.max_fps=60
	var personal:=FileAccess.get_file_as_bytes(State.DEFAULT_PATH) if FileAccess.file_exists(State.DEFAULT_PATH) else PackedByteArray()
	demo=Scene.instantiate();demo.persistence=false;demo.collection_directory=OUT+"/works";root.add_child(demo);await settle();isolate_input()
	var voices:=pool();var fixture:=ContractFixture.courtyard();check(fixture.ok,"public one-building enclosed court and through path")
	await show(fixture.city,Vector2(-24.4,-16.4),"庭院空间契约");quiet();demo.life.set_process(false)
	demo.focus=Vector3(-24.4,.5,-16.4);demo.zoom=19.;demo.pitch=.85;demo.yaw=.3;demo._update_camera();await settle()
	var report:Dictionary=demo.state.functional_zones();var original:=meshes();var author:Dictionary=demo.state.snapshot()
	check(report.spaces.size()==1 and report.spaces[0].stage=="district","published road/actual portal activates single-house district")
	for size:Vector2i in [Vector2i(1440,900),Vector2i(1024,768)]:
		root.size=size;await key(KEY_L);await refresh_page()
		check(demo.ledger.visible() and "庭院空间" in demo.ledger.body.text and "成区" in demo.ledger.body.text and "公共通口已接通" in demo.ledger.body.text,"native L shows real district and reason "+str(size.x))
		check("接路记录保留原权益，不等同于成区" in demo.ledger.body.text,"old active/rights not relabelled as district")
		check(demo.ledger.scrollbook.get_global_rect().end.y<=size.y,"L page fits viewport "+str(size.x));await capture("district_"+str(size.x))
		await key(KEY_ESCAPE);check(not demo.ledger.visible(),"native Escape closes ledger")
	check(demo.state.snapshot()==author,"reading new page does not edit author/history")
	root.size=Vector2i(1440,900);demo.ui_layer.hide();await capture("court_portal_day");demo._set_light_phase(1);await capture("court_portal_evening");demo.ui_layer.show()
	var removed:Dictionary=demo.state.remove_road("r1");demo._after_edit(removed,"history");await settle();quiet();demo.life.set_process(false)
	check(removed.ok and demo.state.functional_zones().spaces[0].stage=="cluster","actual road removal keeps real courtyard but revokes district")
	await key(KEY_L);await refresh_page();check("局部空间" in demo.ledger.body.text and "需要通向院内的公共入口" in demo.ledger.body.text,"L explains local court lacking public access");await capture("disconnected_cluster");await key(KEY_ESCAPE)
	await key(KEY_Z,true);await settle();quiet();demo.life.set_process(false)
	check(demo.state.functional_zones()==report and meshes()==original,"native Undo restores exact source report and installed arrays")
	await key(KEY_Y,true);await settle();quiet();demo.life.set_process(false);check(demo.state.functional_zones().spaces[0].stage=="cluster","native Redo withdraws district")
	await key(KEY_Z,true);await settle();quiet();demo.life.set_process(false)
	var path:=OUT+"/work.json";FileAccess.open(path,FileAccess.WRITE).store_string(JSON.stringify(demo.state.snapshot(),"",true,true))
	var cold:=State.new();check(cold.restore(JSON.parse_string(FileAccess.get_file_as_string(path))).ok,"isolated real disk cold read")
	await show(cold,Vector2(-24.4,-16.4),"庭院冷读");quiet();demo.life.set_process(false)
	check(demo.state.functional_zones()==report and meshes()==original,"independent cold report and mesh arrays equal incremental")
	var single:=State.new();single.initialize_free();check(single.add_house(Vector2(-28,-20)).ok,"actual single home")
	await show(single,Vector2(-28,-20),"单屋特色");quiet();demo.life.set_process(false);await key(KEY_L);await refresh_page()
	check("居住体量" in demo.ledger.body.text and "特色" in demo.ledger.body.text and not "公共通口已接通" in demo.ledger.body.text,"single home has trait, no invented district");await capture("single_trait");await key(KEY_ESCAPE)
	facts.master=await Probe.record(OUT+"/Master.wav",3.2);check(facts.master.ok and pool()==voices,"original pool and actual unclipped Master PCM")
	var classic:=State.new();classic.initialize();await show(classic,Vector2(-6,-1),"经典账本");quiet();demo.life.set_process(false)
	await key(KEY_L);await refresh_page();check(demo.ledger.button.text=="生活账本 · L" and demo.ledger.guide_button.visible,"classic ledger preserved");await key(KEY_ESCAPE)
	check(personal==(FileAccess.get_file_as_bytes(State.DEFAULT_PATH) if FileAccess.file_exists(State.DEFAULT_PATH) else PackedByteArray()),"personal save untouched")
	var result:={"ok":failures.is_empty(),"checks":checks,"failures":failures,"facts":facts,"spaces":report.spaces};FileAccess.open(OUT+"/report.json",FileAccess.WRITE).store_string(JSON.stringify(result,"\t"));print("COURTYARD_CONTRACT_LIVE ",JSON.stringify(result));demo.queue_free();await process_frame;quit(0 if failures.is_empty() else 1)
