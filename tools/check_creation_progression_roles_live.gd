extends "res://tools/check_creation_progression_ui_live.gd"
const Brush=preload("res://scripts/world/city_creation_build_brush.gd")
func run()->void:
	for arg:String in OS.get_cmdline_user_args():
		if arg.begins_with("--out-dir="):OUT=arg.trim_prefix("--out-dir=")
	if not OS.get_cmdline_user_args().has("--isolated-session") or not OUT.begins_with("res://验证记录/") or DirAccess.dir_exists_absolute(OUT):push_error("new isolated evidence directory required");quit(1);return
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(OUT));root.size=Vector2i(1440,900);Engine.max_fps=60
	var began:=Time.get_ticks_msec();var personal:=FileAccess.get_file_as_bytes(State.DEFAULT_PATH) if FileAccess.file_exists(State.DEFAULT_PATH) else PackedByteArray()
	demo=Scene.instantiate();demo.persistence=false;demo.collection_directory=OUT+"/works";root.add_child(demo);await settle();isolate_input();quiet();var voices:=pool()
	check(demo.state.cozy_progression.enabled,"actual new scene starts enabled")
	check(Brush.select(demo.state,"pastoral","rotunda"),"select actual atelier prototype")
	demo.focus=Vector3(-20,.8,-12);demo.zoom=23.;demo._update_camera();await settle()
	await click_world(Vector2(-28,-12));await settle();quiet()
	check(demo.state.houses.size()==1 and demo.state.houses[0].role=="atelier" and demo.state.cozy_progression.xp==2,"native active construction seeds atelier in same earning transaction")
	var page:Node=await journal();await ui_click(page.action);await settle();await key(KEY_ESCAPE)
	check(page.last_result.get("ok",false) and not demo.state.cozy_progression.enabled,"native J pauses seeding policy")
	await click_world(Vector2(-22,-12));await settle();quiet()
	check(demo.state.houses.size()==2 and demo.state.houses[1].role=="residential" and demo.state.houses[0].role=="atelier","native paused construction stays dwelling without clearing older purpose")
	var authored:Array=demo.state.houses.duplicate(true)
	await key(KEY_Z,true);await settle();quiet();await key(KEY_Y,true);await settle();quiet()
	check(demo.state.houses==authored,"native paused UndoRedo restores exact original fields")
	page=await journal();await ui_click(page.action);await settle();await key(KEY_ESCAPE)
	check(page.last_result.get("ok",false) and demo.state.cozy_progression.enabled and demo.state.houses[1].role=="residential","resume does not retrofit paused building purpose")
	await click_world(Vector2(-16,-12));await settle();quiet()
	check(demo.state.houses.size()==3 and demo.state.houses[2].role=="atelier" and demo.state.cozy_progression.xp==4,"native resumed construction seeds only new building")
	var result:Dictionary=demo.state.set_house_role("h1","bakery");demo._after_edit(result,"history");await settle();quiet()
	check(result.ok and demo.state.houses[0].role=="bakery","manual purpose overrides default")
	await key(KEY_Z,true);await settle();quiet();await key(KEY_Y,true);await settle();quiet()
	check(demo.state.houses[0].role=="bakery","manual purpose survives native history replay")
	await capture("active_paused_resumed_roles")
	var snapshot:Dictionary=JSON.parse_string(JSON.stringify(demo.state.snapshot(),"",true,true));var cold:=State.new()
	var restored:Dictionary=cold.restore(snapshot)
	FileAccess.open(OUT+"/cold_source.json",FileAccess.WRITE).store_string(JSON.stringify(snapshot,"\t",true,true))
	FileAccess.open(OUT+"/cold_restored.json",FileAccess.WRITE).store_string(JSON.stringify(cold.snapshot(),"\t",true,true))
	check(restored.ok and preload("res://scripts/world/city_creation_progression_backup.gd").same_decoded(cold.snapshot(),snapshot),"mixed authored purposes cold-restore without reseeding")
	check(demo.state.life_progress.purchases==0 and demo.state.life_progress.tea_parties==0,"no fabricated purchase or tea events")
	check(pool()==voices,"original audio pool unchanged")
	check(personal==(FileAccess.get_file_as_bytes(State.DEFAULT_PATH) if FileAccess.file_exists(State.DEFAULT_PATH) else PackedByteArray()),"personal save unchanged")
	var report:={"ok":failures.is_empty(),"checks":checks,"failures":failures,"seconds":(Time.get_ticks_msec()-began)/1000.}
	FileAccess.open(OUT+"/report.json",FileAccess.WRITE).store_string(JSON.stringify(report,"\t"));print("PROGRESSION_ROLES_LIVE ",JSON.stringify(report));demo.queue_free();await process_frame;quit(0 if failures.is_empty() else 1)
