extends "res://tools/check_creation_curved_lane_live.gd"
const ShoreFixture=preload("res://tools/fixtures/city_creation_waterfront_contract_fixture.gd")
func shore_rows()->Array:return demo.state.functional_zones().spaces.filter(func(s):return s.kind=="waterfront")
func page(label:String,expected:String)->void:
	await key(KEY_L);await refresh_page()
	check(demo.ledger.visible() and expected in demo.ledger.body.text,"native L shore diagnosis "+label)
	check(demo.ledger.scrollbook.get_global_rect().end.y<=root.size.y,"shore page fits "+label)
	await capture(label);await key(KEY_ESCAPE)
func run()->void:
	OUT="res://验证记录/M84/waterfront_contract_20261030/live"
	for arg:String in OS.get_cmdline_user_args():
		if arg.begins_with("--out-dir="):OUT=arg.trim_prefix("--out-dir=")
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(OUT));root.size=Vector2i(1440,900);Engine.max_fps=60
	var began:=Time.get_ticks_msec();var personal:=FileAccess.get_file_as_bytes(State.DEFAULT_PATH) if FileAccess.file_exists(State.DEFAULT_PATH) else PackedByteArray()
	demo=Scene.instantiate();demo.persistence=false;demo.collection_directory=OUT+"/works";root.add_child(demo);await settle();isolate_input()
	var voices:=pool();var f:=ShoreFixture.build();check(f.ok,"actual long gallery, authored pond and public street")
	await show(f.city,Vector2(-26,-17),"真实面水公共界面");quiet();demo.life.set_process(false)
	demo.focus=Vector3(-26.,.5,-17.);demo.zoom=21.;demo.pitch=.85;demo.yaw=.3;demo._update_camera();await settle()
	var report:Dictionary=demo.state.functional_zones();var initial:=meshes();var roads:=road_meshes();var authored:Dictionary=demo.state.snapshot()
	check(shore_rows().size()==1 and shore_rows()[0].eligibility.district and shore_rows()[0].evidence.public_entries.size()==3,"single actual gallery qualifies with three real shore entries")
	check(demo.state.houses.size()==1 and demo.town.house_roots.has("h1") and demo.town.road_roots.has("r1"),"one installed body and actual street carry the public sources")
	await select_house("h1");await key(KEY_ESCAPE)
	for size:Vector2i in [Vector2i(1440,900),Vector2i(1024,768)]:
		root.size=size;await page("shore_ledger_"+str(size.x),"面水公共界面 · 入口与公共路网已接通")
	check(demo.state.snapshot()==authored,"native read/pick preserve authored shore and receipts")
	root.size=Vector2i(1440,900);demo.ui_layer.hide()
	for phase in range(3):demo._set_light_phase(phase);await create_timer(.5).timeout;await capture("shore_phase"+str(phase))
	demo.ui_layer.show();var changed:Dictionary=demo.state.remove_water_at(ShoreFixture.ORIGIN+Vector2(0,6));demo._after_edit(changed,"history");await settle();quiet();demo.life.set_process(false)
	check(changed.ok and not shore_rows()[0].eligibility.district,"actual water removal withdraws shore qualification")
	await page("water_removed","附近尚无真实水域")
	await key(KEY_Z,true);await settle();quiet();demo.life.set_process(false)
	check(demo.state.functional_zones()==report and meshes()==initial and road_meshes()==roads,"native Undo restores exact pond sources and installed arrays")
	await key(KEY_Y,true);await settle();quiet();demo.life.set_process(false);check(not shore_rows()[0].eligibility.district,"native Redo removes real shore again")
	await key(KEY_Z,true);await settle();quiet();demo.life.set_process(false)
	var wall:=ShoreFixture.build("wall");check(wall.ok,"public actual intervening wall")
	await show(wall.city,Vector2(-26,-17),"隔墙近水反例");quiet();demo.life.set_process(false);var blocked:=meshes();var blocked_report:Dictionary=demo.state.functional_zones()
	check(not shore_rows().any(func(s):return s.eligibility.district),"actual wall cannot borrow the gallery's road")
	await page("wall_blocked","尚无可用的面水公共界面")
	changed=demo.state.remove_house("h2");demo._after_edit(changed,"history");await settle();quiet();demo.life.set_process(false)
	check(changed.ok and shore_rows()[0].eligibility.district,"removing installed wall opens the real interface");await page("wall_removed","入口与公共路网已接通")
	await key(KEY_Z,true);await settle();quiet();demo.life.set_process(false)
	check(demo.state.functional_zones()==blocked_report and meshes()==blocked,"native Undo restores exact wall obstruction and evidence")
	var ridge:=ShoreFixture.build();check(ridge.ok,"actual terrain counterexample source")
	for i in range(2):check(ridge.city.add_terrain_stroke([ShoreFixture.ORIGIN+Vector2(-3,3.7),ShoreFixture.ORIGIN+Vector2(7,3.7)] as Array[Vector2],"plateau",1.3,1.,2).ok,"public ridge stroke")
	await show(ridge.city,Vector2(-26,-17),"面水通路地形反例");quiet();demo.life.set_process(false)
	check(not shore_rows()[0].eligibility.district and shore_rows()[0].eligibility.reason=="ground_access_missing","real ridge cannot count as open public shore")
	facts.ridge_height=demo.state.ground_height(ShoreFixture.ORIGIN+Vector2(1.8,4));check(facts.ridge_height>1.5,"actual published terrain contains the blocking ridge")
	await page("terrain_blocked","面水通路地形受阻")
	var path:=OUT+"/work.json";var file:=FileAccess.open(path,FileAccess.WRITE);file.store_string(JSON.stringify(authored,"",true,true));file.close()
	var cold:=State.new();check(cold.restore(JSON.parse_string(FileAccess.get_file_as_string(path))).ok,"independent shore disk restore")
	await show(cold,Vector2(-26,-17),"水岸独立冷读");quiet();demo.life.set_process(false)
	check(demo.state.functional_zones()==report and meshes()==initial and road_meshes()==roads,"cold shore report and actual house/road arrays equal incremental publication")
	facts.master=await Probe.record(OUT+"/Master.wav",3.2);check(facts.master.ok and pool()==voices,"actual unclipped PCM and original player pool")
	check(personal==(FileAccess.get_file_as_bytes(State.DEFAULT_PATH) if FileAccess.file_exists(State.DEFAULT_PATH) else PackedByteArray()),"personal save remains unchanged")
	var result:={"ok":failures.is_empty(),"checks":checks,"failures":failures,"facts":facts,"spaces":report.spaces,"elapsed_seconds":(Time.get_ticks_msec()-began)/1000.}
	FileAccess.open(OUT+"/report.json",FileAccess.WRITE).store_string(JSON.stringify(result,"\t"));print("WATERFRONT_LIVE ",JSON.stringify(result));demo.queue_free();await process_frame;quit(0 if failures.is_empty() else 1)
