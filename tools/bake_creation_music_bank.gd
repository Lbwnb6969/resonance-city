extends SceneTree
## Compile exactly the production PCM once; preserve replaced banks locally.
const Music=preload("res://scripts/audio/city_creation_music.gd")
const Cache=preload("res://scripts/audio/city_creation_bank_cache.gd")
func _initialize()->void:_run.call_deferred()
func _run()->void:
	Engine.max_fps=180;var music:=Music.new();var worker:=Thread.new();var started:=Time.get_ticks_usec()
	var signature:=Cache.source_signature()
	worker.start(music._render_bank)
	while worker.is_alive():await process_frame
	var bank:Dictionary=worker.wait_to_finish();var resource:=Resource.new()
	if signature!=Cache.source_signature():push_error("Synthesis sources changed during bake");music.free();quit(1);return
	resource.set_meta("signature",signature);resource.set_meta("bank",bank)
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path("res://资源/音乐"))
	var temporary:="res://资源/音乐/声部库待发布_%d.res"%Time.get_ticks_usec()
	var error:=ResourceSaver.save(resource,temporary,ResourceSaver.FLAG_COMPRESS)
	if error!=OK:push_error("PCM bake save failed: "+str(error));music.free();quit(1);return
	# Compare saved bytes against this exact production synthesis, before the
	# previous bank is archived or the replacement becomes visible to players.
	var restored:Dictionary=ResourceLoader.load(temporary,"",ResourceLoader.CACHE_MODE_IGNORE).get_meta("bank")
	var compared:=0
	for group:String in ["streams","edits","variations","harmony"]:
		if restored[group].keys()!=bank[group].keys():push_error("PCM bank keys changed during save");music.free();quit(1);return
		for key:String in bank[group]:
			var expected:AudioStreamWAV=bank[group][key];var actual:AudioStreamWAV=restored[group][key]
			if actual.data!=expected.data or actual.format!=expected.format or actual.mix_rate!=expected.mix_rate or actual.stereo!=expected.stereo or actual.loop_mode!=expected.loop_mode or actual.loop_begin!=expected.loop_begin or actual.loop_end!=expected.loop_end:
				push_error("PCM round-trip mismatch: "+key);music.free();quit(1);return
			compared+=1
	if restored.report!=bank.report:push_error("PCM note/peak report changed during save");music.free();quit(1);return
	if FileAccess.file_exists(Cache.PATH):
		var archive:="res://废弃/音乐声部库_%d_%d"%[int(Time.get_unix_time_from_system()),Time.get_ticks_usec()]
		DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(archive))
		FileAccess.open(archive+"/归档计划.json",FileAccess.WRITE).store_string(JSON.stringify({"replaced_asset":Cache.PATH,"consumer":"city_creation_bank_cache.gd","replacement":temporary,"source_signature":signature,"embedded_streams":true},"\t"))
		error=DirAccess.rename_absolute(ProjectSettings.globalize_path(Cache.PATH),ProjectSettings.globalize_path(archive+"/城市同步声部库.res"))
		if error!=OK:push_error("PCM bank archive failed: "+str(error));music.free();quit(1);return
	error=DirAccess.rename_absolute(ProjectSettings.globalize_path(temporary),ProjectSettings.globalize_path(Cache.PATH))
	if error!=OK:push_error("PCM bank publication failed: "+str(error));music.free();quit(1);return
	FileAccess.open("res://scripts/audio/city_creation_bank_stamp.gd",FileAccess.WRITE).store_string("extends RefCounted\n## Generated by tools/bake_creation_music_bank.gd; valid in exported PCKs.\nconst SIGNATURE:=\""+signature+"\"\n")
	var bytes:=0
	for stream:AudioStreamWAV in bank.streams.values():bytes+=stream.data.size()
	for stream:AudioStreamWAV in bank.edits.values():bytes+=stream.data.size()
	for stream:AudioStreamWAV in bank.variations.values():bytes+=stream.data.size()
	for stream:AudioStreamWAV in bank.harmony.values():bytes+=stream.data.size()
	print("MUSIC_BANK_BAKED ",JSON.stringify({"signature":signature,"long_streams":bank.streams.size(),"short_streams":bank.edits.size(),"variation_streams":bank.variations.size(),"exact_round_trips":compared,"pcm_bytes":bytes,"file_bytes":FileAccess.get_file_as_bytes(Cache.PATH).size(),"elapsed_ms":float(Time.get_ticks_usec()-started)/1000.}));music.free();quit(0)
