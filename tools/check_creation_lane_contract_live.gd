extends "res://tools/check_creation_functional_zones_live.gd"
const LaneFixture=preload("res://tools/fixtures/city_creation_space_contract_fixture.gd")
func lane_rows()->Array:
	return demo.state.functional_zones().spaces.filter(func(s):return s.evidence.geometry=="narrow_lane")
func run()->void:
	OUT="res://验证记录/M84/narrow_lane_20261029/live"
	for arg:String in OS.get_cmdline_user_args():
		if arg.begins_with("--out-dir="):OUT=arg.trim_prefix("--out-dir=")
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(OUT));root.size=Vector2i(1440,900);Engine.max_fps=60
	var began:=Time.get_ticks_msec();var personal:=FileAccess.get_file_as_bytes(State.DEFAULT_PATH) if FileAccess.file_exists(State.DEFAULT_PATH) else PackedByteArray()
	demo=Scene.instantiate();demo.persistence=false;demo.collection_directory=OUT+"/works";root.add_child(demo);await settle();isolate_input()
	var voices:=pool();var f:=LaneFixture.lane();check(f.ok,"real three-owner facade fixture")
	await show(f.city,Vector2(-27,-18),"连续窄巷");quiet();demo.life.set_process(false)
	demo.focus=Vector3(-27.,.3,-17.8);demo.zoom=18.;demo.pitch=.85;demo.yaw=1.15;demo._update_camera();await settle()
	var report:Dictionary=demo.state.functional_zones();var authored:Dictionary=demo.state.snapshot();var initial:=meshes()
	check(lane_rows().size()==1 and lane_rows()[0].stage=="district" and lane_rows()[0].members.size()==3,"actual publication qualifies three facing owners")
	check(not lane_rows()[0].eligibility.warm,"ordinary lane never grants enclosed Warm")
	await select_house("h1");await key(KEY_ESCAPE)
	for size:Vector2i in [Vector2i(1440,900),Vector2i(1024,768)]:
		root.size=size;await key(KEY_L);await refresh_page()
		check(demo.ledger.visible() and "连续窄巷" in demo.ledger.body.text and "两侧入口与公共路网已接通" in demo.ledger.body.text and "成区" in demo.ledger.body.text,"native L exposes real lane evidence "+str(size.x))
		check(demo.ledger.scrollbook.get_global_rect().end.y<=size.y,"lane page fits "+str(size.x));await capture("lane_ledger_"+str(size.x));await key(KEY_ESCAPE)
	check(demo.state.snapshot()==authored,"native picks and ledger cannot write geometry or receipts")
	root.size=Vector2i(1440,900);demo.ui_layer.hide()
	for phase in range(3):demo._set_light_phase(phase);await create_timer(.5).timeout;await capture("lane_phase"+str(phase))
	demo.ui_layer.show()
	var changed:Dictionary=demo.state.remove_road("r1")
	check(changed.ok and not lane_rows().any(func(s):return s.eligibility.district),"road deletion withdraws qualification before network publication")
	demo._after_edit(changed,"history");await settle();quiet();demo.life.set_process(false)
	check(lane_rows().is_empty() and not demo.town.road_roots.has("r1"),"actual street and evidence both leave published city")
	await key(KEY_L);await refresh_page();check(not "连续窄巷" in demo.ledger.body.text,"native ledger withdraws removed street");await capture("road_removed");await key(KEY_ESCAPE)
	await key(KEY_Z,true);await settle();quiet();demo.life.set_process(false)
	check(demo.state.functional_zones()==report and meshes()==initial and demo.town.road_roots.has("r1"),"native Undo restores exact evidence and actual street")
	await key(KEY_Y,true);await settle();quiet();demo.life.set_process(false);check(lane_rows().is_empty(),"native Redo removes lane")
	await key(KEY_Z,true);await settle();quiet();demo.life.set_process(false)
	var presentation:Dictionary=demo.state.creative_settings.presentation.duplicate();presentation.automatic_decoration=false
	changed=demo.state.CreationPolicy.set_preferences(demo.state,{"presentation":presentation});demo._after_edit(changed,"history");await settle();quiet();demo.life.set_process(false)
	check(changed.ok and lane_rows()==report.spaces,"decoration toggle preserves real lane qualification")
	await key(KEY_Z,true);await settle();quiet();demo.life.set_process(false)
	var path:=OUT+"/work.json";var file:=FileAccess.open(path,FileAccess.WRITE);file.store_string(JSON.stringify(demo.state.snapshot(),"",true,true));file.close()
	var cold:=State.new();check(cold.restore(JSON.parse_string(FileAccess.get_file_as_string(path))).ok,"independent disk cold read")
	await show(cold,Vector2(-27,-18),"窄巷冷读");quiet();demo.life.set_process(false)
	check(demo.state.functional_zones()==report and meshes()==initial,"cold network/installed geometry equal incremental publication")
	changed=demo.state.remove_road("r1");check(changed.ok,"replace sparse actual street with collinear samples")
	var samples:Array[Vector2]=[]
	for i in range(21):samples.append(LaneFixture.ORIGIN+Vector2(-2.+i*.3,2.2))
	changed=demo.state.add_road(samples,"path","none");demo._after_edit(changed,"history");await settle();quiet();demo.life.set_process(false)
	check(changed.ok and lane_rows().size()==1 and lane_rows()[0].stage=="district" and lane_rows()[0].members==report.spaces[0].members,"actual 21-point street retains continuous qualification")
	await key(KEY_L);await refresh_page();check("两侧入口与公共路网已接通" in demo.ledger.body.text,"native dense-sampled street remains explained");await capture("sampled_street");await key(KEY_ESCAPE)
	var mixed:=LaneFixture.courtyard("U","none")
	check(mixed.ok and mixed.city.add_house_stroke(Vector2(-32.4,-16.4),[{"x":0,"z":0,"level":0,"kind":"room"}]).ok and mixed.city.rotate_house("h2",PI*.5).ok,"actual mixed courtyard and facing owner")
	check(mixed.city.add_road([Vector2(-30.2,-22),Vector2(-30.2,-10)] as Array[Vector2],"path","none").ok,"actual public interface beside half enclosure")
	await show(mixed.city,Vector2(-27,-16),"混合公共空间");quiet();demo.life.set_process(false)
	var combined:Array=demo.state.functional_zones().spaces
	check(combined.any(func(s):return s.evidence.geometry=="half_enclosure" and s.evidence.usable_tiles==12) and not lane_rows().is_empty(),"installed city preserves independent lane and half-enclosure evidence")
	await key(KEY_L);await refresh_page();check("半围合" in demo.ledger.body.text and "连续窄巷" in demo.ledger.body.text,"native L retains both actual interfaces");await capture("mixed_interfaces");await key(KEY_ESCAPE)
	var rotated:=LaneFixture.lane(2.6,.4,true);check(rotated.ok,"public oblique facing houses")
	await show(rotated.city,Vector2(-26,-18),"斜向窄巷");quiet();demo.life.set_process(false)
	check(lane_rows().size()==1 and lane_rows()[0].stage=="district","oblique walls retain actual public interface")
	await key(KEY_L);await refresh_page();check("连续窄巷" in demo.ledger.body.text,"native oblique ledger");await capture("rotated_ledger");await key(KEY_ESCAPE)
	facts.master=await Probe.record(OUT+"/Master.wav",3.2);check(facts.master.ok and pool()==voices,"actual unclipped PCM and original bounded pool")
	var classic:=State.new();classic.initialize();await show(classic,Vector2(-6,-1),"经典账本");quiet();demo.life.set_process(false)
	await key(KEY_L);await refresh_page();check(demo.ledger.button.text=="生活账本 · L" and demo.ledger.guide_button.visible,"classic ledger survives mode change");await key(KEY_ESCAPE)
	check(personal==(FileAccess.get_file_as_bytes(State.DEFAULT_PATH) if FileAccess.file_exists(State.DEFAULT_PATH) else PackedByteArray()),"personal save unchanged")
	var result:={"ok":failures.is_empty(),"checks":checks,"failures":failures,"facts":facts,"spaces":report.spaces,"elapsed_seconds":(Time.get_ticks_msec()-began)/1000.}
	FileAccess.open(OUT+"/report.json",FileAccess.WRITE).store_string(JSON.stringify(result,"\t"));print("LANE_CONTRACT_LIVE ",JSON.stringify(result));demo.queue_free();await process_frame;quit(0 if failures.is_empty() else 1)
