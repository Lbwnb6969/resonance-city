#version 460
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 1, r11f_g11f_b10f) uniform writeonly image2D output_tex;
layout(set = 1, binding = 0) uniform sampler samplers_lnc;
layout(set = 0, binding = 0) uniform texture2DArray input_tex;

void main()
{
    imageStore(output_tex, ivec2(gl_GlobalInvocationID.xy), vec4(textureLod(sampler2DArray(input_tex, samplers_lnc), vec3((vec2(ivec2(gl_GlobalInvocationID.xy)) + vec2(0.5)) / vec2(uvec2(imageSize(output_tex))), 0.0), 0.0).xyz, 0.0));
}

