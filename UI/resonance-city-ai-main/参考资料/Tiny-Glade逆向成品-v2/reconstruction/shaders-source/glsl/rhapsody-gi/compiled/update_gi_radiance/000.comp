#version 460
#extension GL_EXT_samplerless_texture_functions : require
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

const uvec2 _56[4] = uvec2[](uvec2(0u), uvec2(0u, 1u), uvec2(1u), uvec2(1u, 0u));

layout(set = 1, binding = 0, std140) uniform FrameCounter_natural
{
    uint index;
} frame_counter;

layout(set = 0, binding = 1) uniform texture2D depth_tex;
layout(set = 0, binding = 3) uniform texture2D candidate_hit_tex;
layout(set = 0, binding = 2) uniform texture2D candidate_radiance_tex;
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D restir_radiance_out_tex;
layout(set = 0, binding = 5, rgba16f) uniform writeonly image2D restir_ray_dir_out_tex;
layout(set = 0, binding = 6, rg32ui) uniform writeonly uimage2D restir_reservoir_out_tex;

void main()
{
    imageStore(restir_radiance_out_tex, ivec2(gl_GlobalInvocationID.xy), texelFetch(candidate_radiance_tex, ivec2(gl_GlobalInvocationID.xy), 0));
    imageStore(restir_ray_dir_out_tex, ivec2(gl_GlobalInvocationID.xy), vec4(texelFetch(candidate_hit_tex, ivec2(gl_GlobalInvocationID.xy), 0).xyz, texelFetch(depth_tex, ivec2((gl_GlobalInvocationID.xy * uvec2(2u)) + _56[frame_counter.index & 3u]), 0).x));
    uint _302 = packHalf2x16(vec2(1.0));
    imageStore(restir_reservoir_out_tex, ivec2(gl_GlobalInvocationID.xy), uvec4(gl_GlobalInvocationID.x | (gl_GlobalInvocationID.y << uint(16)), _302, 0u, 0u));
}

