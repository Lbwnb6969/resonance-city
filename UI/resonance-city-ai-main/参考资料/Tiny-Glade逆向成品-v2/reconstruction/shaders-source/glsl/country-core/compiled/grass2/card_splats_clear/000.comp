#version 460
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, std140) uniform GlobalParams_natural
{
    uvec2 splat_depth_dims;
} globalParams;

layout(push_constant, std430) uniform EntryPointParams_natural
{
    uint clear_value;
} entryPointParams;

layout(set = 0, binding = 1, r32ui) uniform writeonly uimage2D splat_depth;

void main()
{
    do
    {
        if (any(greaterThanEqual(gl_GlobalInvocationID.xy, globalParams.splat_depth_dims)))
        {
            break;
        }
        imageStore(splat_depth, ivec2(gl_GlobalInvocationID.xy), uvec4(entryPointParams.clear_value));
        break;
    } while(false);
}

