extends SceneTree
const State=preload("res://scripts/world/city_creation_state.gd")
const Network=preload("res://scripts/world/city_creation_network.gd")
const DEST="res://数据/庆典接力样例.json"
func _initialize() -> void: _run.call_deferred()
func _must(result: Dictionary) -> void: assert(result.ok,str(result))
func _run() -> void:
	assert(not FileAccess.file_exists(DEST),"Keep the authored example immutable; move an obsolete version to 废弃 before regenerating.")
	var city=State.new()
	for at: Vector2 in [Vector2(-15,-3),Vector2(-10,-3),Vector2(-5,-3),Vector2(-15,1),Vector2(-10,1),Vector2(-5,1)]: _must(city.add_house(at))
	_must(city.set_house_role("h4","bakery"))
	_must(city.set_house_name("h4","晨炉面包坊"))
	_must(city.set_house_role("h5","venue"));_must(city.set_house_name("h5","暖庭小舞台"))
	_must(city.set_house_role("h6","venue"));_must(city.set_house_name("h6","深流小舞台"))
	for z: float in [-1.45,2.55]: _must(city.add_road([Vector2(-16.2,z),Vector2(-3.8,z)]))
	_must(city.add_road([Vector2(-12.5,-1.45),Vector2(-12.5,2.55)]))
	_must(city.add_district([Vector2(-10,-3),Vector2(-10,1)],4.0,"warm"))
	_must(city.add_district([Vector2(-5,-3),Vector2(-5,1)],4.0,"deep"))
	var graph=Network.new().prepare(city.snapshot(),{},[])
	assert(graph.connected_houses.size()==6)
	for id: String in graph.connected_houses: assert(not graph._route(graph.connected_houses[id],graph.connected_houses["h5"]).is_empty())
	for value: Variant in city.life_progress.values(): assert(value==0)
	assert(city.bakery_supply.is_empty() and city.workshop_supply.is_empty() and city.growth_memories.is_empty() and city.journey_checkpoint.is_empty())
	_must(city.save_city(DEST))
	var loaded=State.new();_must(loaded.load_city(DEST))
	assert(loaded.houses==city.houses)
	print("CONCERT_RELAY_EXAMPLE PASS houses=6 venues=h5,h6 roads=3 zero-business-ledger")
	quit()
