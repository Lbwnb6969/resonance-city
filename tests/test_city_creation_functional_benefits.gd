extends SceneTree
const State=preload("res://scripts/world/city_creation_state.gd")
const Life=preload("res://scripts/world/city_creation_life.gd")
const Receipts=preload("res://scripts/world/city_creation_harmony_receipts.gd")
const Fixture=preload("res://tools/fixtures/city_creation_functional_zones_fixture.gd")
var checks:=0
var failures:Array=[]
func check(ok:bool,label:String)->void:
	checks+=1
	if not ok:failures.append(label);push_error(label)
func _initialize()->void:run.call_deferred()
func run()->void:
	var fixture:=Fixture.build();var city:RefCounted=fixture.city;check(fixture.ok,"actual four spatial kinds")
	Receipts.initialize(city);var historical:Dictionary=city.snapshot()
	check(city.functional_benefits().inspiration_multiplier==1. and not "clockwork_waltz" in city.synergy_buffs().active_chords,"unpublished graph grants no spatial rights")
	var life:=Life.new();root.add_child(life);life.set_process(false);life.setup(city)
	var view:Dictionary=city.functional_benefits()
	check(is_equal_approx(view.inspiration_multiplier,1.35) and view.artisan_sources==["h3"],"real connected workshop supplies one global 35 percent source")
	check("h5" in view.mutual.h6 and "h6" in view.mutual.h5,"distant market and dwelling mutually support on same real street component without 14m cap")
	check("clockwork_waltz" in city.synergy_buffs().active_chords and "pastoral_triad" in city.synergy_buffs().active_chords,"actual spaces directly enable existing two chord rights")
	var first:Dictionary=Receipts.collect(city)
	check(first.events.get("chord",0)==2 and first.earned==81,"two real new chord receipts grant 60 times 1.35 XP through original accumulator")
	check(Receipts.collect(city).earned==0,"same geometry does not repeatedly grant XP")
	var gained:=0;var per_house:Array=[]
	Fixture.Brush.select(city,"pastoral","townhouse")
	for i in range(10):
		check(city.add_house(Vector2(-35.+i*3.,16.)).ok,"real new author house")
		life._sync();var earned:Dictionary=Receipts.collect(city);gained+=int(earned.earned);per_house.append(earned.earned)
	check(gained==27 and absf(float(city.harmony_journey.xp_remainder))<.000001,"fractional carry yields exactly 27 XP from ten real 2 XP homes")
	Fixture.Brush.select(city,"clockwork","clock_turret");check(city.add_house(Vector2(-35,26)).ok and city.add_road([Vector2(-37,27.9),Vector2(-33,27.9)] as Array[Vector2],"path","none").ok,"independent second artisan component")
	life._sync();var production_before:Dictionary=city.workshop_supply.duplicate(true);var more:Dictionary=city.functional_benefits();var extra:Dictionary=Receipts.collect(city)
	check(city.workshop_supply==production_before,"spatial queries and XP do not fabricate production or delivery")
	check(more.artisan_sources.size()==2 and is_equal_approx(more.inspiration_multiplier,1.35),"two artisan zones do not stack global multiplier")
	check(not city.shares_chord("h3","h17","clockwork_waltz"),"unrelated artisan components cannot share a chord source scope")
	check(extra.events.get("chord",0)==0,"new component cannot re-award globally owned chord")
	check(city.remove_road("r1").ok and city.remove_road("r3").ok,"remove real artisan connections")
	check(city.functional_benefits().inspiration_multiplier==1. and not "clockwork_waltz" in city.synergy_buffs().active_chords,"stale graph immediately withdraws multiplier and chord")
	life._sync();check(city.functional_benefits().inspiration_multiplier==1.,"published disconnection keeps multiplier withdrawn")
	check(city.undo().ok and city.undo().ok,"undo both actual road edits");life._sync()
	check(is_equal_approx(city.functional_benefits().inspiration_multiplier,1.35) and Receipts.collect(city).earned==0,"restored geometry restores bonus without refarming receipts")
	var saved:Dictionary=city.snapshot();var cold:=State.new();check(cold.restore(JSON.parse_string(JSON.stringify(saved,"",true,true))).ok,"current fractional XP and spatial chord receipts remain Schema20-compatible")
	var other:=Life.new();root.add_child(other);other.set_process(false);other.setup(cold)
	check(cold.functional_benefits()==city.functional_benefits() and Receipts.collect(cold).earned==0,"cold graph restores same rights and cannot farm old receipts")
	for field:String in ["life_progress","bakery_supply","cafe_progress","regional_trips","regional_replies"]:
		check(city.snapshot().get(field)==historical.get(field),"spatial rights do not fabricate historical "+field)
	check(city.workshop_supply==production_before,"actual preexisting first-craft history survives undo and spatial receipt collection unchanged")
	var solo:=State.new();solo.initialize_free();Fixture.Brush.select(solo,"renaissance","venetian_loggia");solo.add_house(Vector2(-25,-20));solo.add_road([Vector2(-28,-18.1),Vector2(-22,-18.1)] as Array[Vector2],"path","none")
	var single:=Life.new();root.add_child(single);single.set_process(false);single.setup(solo)
	check(solo.functional_benefits().mutual.h1.is_empty() and not "pastoral_triad" in solo.synergy_buffs().active_chords,"one mixed-use building cannot mutually support itself")
	var legacy:=State.new();legacy.initialize_empty();Receipts.initialize(legacy);legacy.add_house(Vector2(-25,-20))
	check(Receipts.collect(legacy).earned==2 and legacy.functional_benefits().inspiration_multiplier==1.,"classic accumulation unchanged")
	legacy_conversion()
	free_vignette()
	life.free();other.free();single.free()
	print("FUNCTIONAL_BENEFITS ",JSON.stringify({"ok":failures.is_empty(),"checks":checks,"failures":failures,"first":first.earned,"construction_xp":gained,"per_house":per_house}));quit(0 if failures.is_empty() else 1)
func legacy_conversion()->void:
	var Recipes=preload("res://tools/fixtures/city_creation_juice_fixture.gd")
	var city:RefCounted=Recipes.city("clockwork_waltz");Recipes.apply(city,"clockwork_waltz",false);Receipts.initialize(city);Recipes.apply(city,"clockwork_waltz",true)
	check(Receipts.collect(city).events.get("chord",0)==1,"actual classic recipe earned before conversion")
	var owned:Dictionary=city.harmony_journey.receipts.duplicate(true)
	var converted:Dictionary=city.CreationPolicy.convert(city,"res://验证记录/M84/spatial_benefits_20261029/converted.json")
	check(converted.ok and FileAccess.file_exists(converted.get("backup","")),"explicit conversion creates verified backup")
	var life:=Life.new();root.add_child(life);life.set_process(false);life.setup(city)
	Receipts.collect(city)
	var clock_keys:Array=[]
	for key:String in city.harmony_journey.receipts:
		if key.begins_with("chord/clockwork_waltz/"):clock_keys.append(key)
	var old_keys:Array=owned.keys().filter(func(k):return str(k).begins_with("chord/clockwork_waltz/"))
	check(not old_keys.is_empty() and clock_keys==old_keys,"converted old chord retains original receipts without issuing second spatial receipt")
	life.free()
func free_vignette()->void:
	var Quest=preload("res://tools/fixtures/city_creation_vignette_fixture.gd")
	var id:String=Quest.Vignettes.IDS[0];var city:RefCounted=Quest.start(id)
	check(city.CreationPolicy.convert(city,"res://验证记录/M84/spatial_benefits_20261029/quest_converted.json").ok,"real offered work converted with backup")
	var built:Array=Quest.construct(city);check(not built.is_empty() and built.all(func(row):return row.ok),"real public river vignette construction")
	Fixture.Brush.select(city,"clockwork","clock_turret")
	check(city.add_house(Vector2(-35,30)).ok and city.add_road([Vector2(-37,31.9),Vector2(-33,31.9)] as Array[Vector2],"path","none").ok,"independent real artisan source for global quest bonus")
	var life:=Life.new();root.add_child(life);life.set_process(false);life.setup(city)
	var reward:Dictionary=Quest.Vignettes.complete(city,life.connected_houses)
	check(not reward.is_empty() and int(reward.xp)==int(floor(float(Quest.Vignettes.template(id).reward_xp)*1.35)),"actual completed free-city vignette grants boosted XP and reports actual payout")
	check(Quest.Vignettes.complete(city,life.connected_houses).is_empty(),"completed free vignette cannot repeat boosted payout")
	life.free()
