extends SceneTree
const State=preload("res://scripts/world/city_creation_state.gd")
const Renderer=preload("res://scripts/visual/city_creation_renderer.gd")
const Pending=preload("res://scripts/visual/city_creation_pending_modules.gd")
var checks:=0
var failures:Array[String]=[]
func _initialize()->void:run.call_deferred()
func check(ok:bool,label:String)->void:
	checks+=1
	if not ok:failures.append(label);push_error(label)
func run()->void:
	var city:=State.new();city.initialize_empty()
	var added:Dictionary=city.add_house(Vector2(-14,-2));check(added.ok,"real initial house")
	var id:=str(added.house_id)
	var town:=Renderer.new();town.state=city;root.add_child(town)
	town.budget_rebuild=Renderer.BudgetRebuild.new();town.budget_rebuild.record_published(city)
	var pending:=Pending.new();pending.sync(town,false)
	check(not pending.tracking and pending.records.is_empty(),"restoring a whole work does not create construction overlays")
	var original:Dictionary=city.snapshot()
	check(city.add_cell(id,0,0,1).ok,"real upper module authoring")
	var authored:Dictionary=city.snapshot();pending.sync(town)
	check(pending.records.size()==1 and pending.root.is_inside_tree(),"committed addition immediately has one visible construction volume")
	check(pending.root.find_children("*","CollisionObject3D",true,false).is_empty(),"construction feedback has no simulation or picking collision bodies")
	check(city.snapshot()==authored,"preparing feedback never mutates the authored city")
	var proxy:Node3D=pending.records[0].node
	check(is_equal_approx(proxy.scale.y,.2) and proxy.find_children("*","MeshInstance3D",true,false).size()==3,"same-handler feedback starts as a colored solid spring proxy with walls roof and windows")
	for mesh:MeshInstance3D in proxy.find_children("*","MeshInstance3D",true,false):check(mesh.material_override.get_meta("creation_wall_batch",false),"every proxy surface uses the wall micro-normal and contact-AO pipeline")
	var roof_normals:PackedVector3Array=Pending.Proxy.roof_mesh().surface_get_arrays(0)[Mesh.ARRAY_NORMAL]
	check(not roof_normals.is_empty() and Array(roof_normals).all(func(normal):return normal.is_finite() and normal.y>=-.0001),"proxy roof uses finite outward/upward slope normals")
	var bounds:AABB=pending.records[0].bounds
	var center:=bounds.get_center()
	var hit:Dictionary=pending.pick(Vector3(center.x,20,center.z),Vector3.DOWN)
	check(not hit.is_empty() and hit.house_id==id and hit.cell_id==city.houses[0].cells[-1].id and hit.normal==Vector3.UP,"top ray identifies the real newly issued cell and upward face")
	check(absf(hit.position.y-bounds.end.y)<.00001,"editing hit uses the actual displayed preview volume")
	var cap:=StaticBody3D.new();root.add_child(cap);cap.set_meta("house_id",id);cap.set_meta("cell",original.houses[0].cells[0])
	check(pending.supersedes(town,{"collider":cap},hit),"obsolete cap below the new authored floor cannot cover its editing target")
	var neighbor:Dictionary=original.houses[0].cells[0].duplicate();neighbor.x=1;cap.set_meta("cell",neighbor)
	check(not pending.supersedes(town,{"collider":cap},hit),"another column retains its real occlusion")
	neighbor.x=0;neighbor.level=2;cap.set_meta("cell",neighbor)
	check(not pending.supersedes(town,{"collider":cap},hit),"an upper published cell retains its occlusion")
	cap.set_meta("house_id","other")
	check(not pending.supersedes(town,{"collider":cap},hit),"another house cannot be superseded by a construction outline")
	cap.queue_free()
	hit=pending.pick(center+Vector3.RIGHT*10,Vector3.LEFT)
	check(not hit.is_empty() and hit.normal==Vector3.RIGHT,"side ray retains the correct expansion face")
	check(pending.pick(Vector3(100,20,100),Vector3.DOWN).is_empty(),"empty space stays empty")
	check(pending.pick(Vector3(center.x,200,center.z),Vector3.DOWN,10.).is_empty(),"ray length matches the editor picking range")
	check(city.add_cell(id,1,0,0).ok,"real second committed module")
	pending.sync(town);check(pending.records[0].node==proxy,"a second edit retains the first spring rather than restarting it");check(pending.records.size()==2,"latest State retains both unpublished additions")
	check(city.undo().ok,"undo second addition before publication")
	pending.sync(town,false);check(pending.records.size()==1,"undo immediately removes only its pending construction volume")
	check(city.undo().ok,"undo first addition before publication")
	pending.sync(town,false)
	check(pending.records.is_empty() and not is_instance_valid(pending.root) and pending.tracking,"empty pending delta stays ready for redo until publication")
	check(city.redo().ok,"redo real addition")
	pending.sync(town,false);check(pending.records.size()==1,"redo recreates its exact unpublished cell outline")
	var stable:Dictionary=city.snapshot();town.budget_rebuild.record_published(city);pending.sync(town,false)
	check(pending.records.is_empty() and city.snapshot()==stable,"a published cell has no duplicate construction volume")
	pending.clear();check(not pending.tracking and pending.records.is_empty(),"completed publication releases all transient state")
	check(city.add_cell(id,0,0,2).ok and city.add_cell(id,0,0,3).ok,"two further real stacked modules")
	pending.sync(town);bounds=pending.records[-1].bounds;center=bounds.get_center()
	hit=pending.pick(Vector3(center.x,20,center.z),Vector3.DOWN)
	check(hit.cell_id==city.houses[0].cells[-1].id,"nearest pending volume wins over an earlier lower volume")
	check(city.add_cell(id,1,0,0,"terrace").ok,"real ground terrace")
	pending.sync(town);bounds=pending.records[-1].bounds;center=bounds.get_center()
	check(absf(bounds.size.y-.19)<.00001 and pending.pick(center+Vector3.UP*10,Vector3.DOWN).cell.kind=="terrace","terrace feedback and picking use the real low terrace volume")
	var until:=Time.get_ticks_msec()+250
	while Time.get_ticks_msec()<until:await process_frame
	check(pending.records.all(func(row):return is_equal_approx(row.node.scale.y,1.)),"the 180ms back-ease springs settle at exact authored height")
	pending.clear()
	check(original.houses[0].cells.size()==1,"original published snapshot remains immutable")
	Renderer.BudgetRebuild.new()._dispose_context(town)
	await process_frame
	print("PENDING_MODULES ",JSON.stringify({"ok":failures.is_empty(),"checks":checks,"failures":failures}))
	quit(0 if failures.is_empty() else 1)
