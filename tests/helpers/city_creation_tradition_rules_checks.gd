extends RefCounted
const Fixture=preload("res://tools/fixtures/city_creation_tradition_fixture.gd")
const State=preload("res://scripts/world/city_creation_state.gd")
const Life=preload("res://scripts/world/city_creation_life.gd")
const Rules=preload("res://scripts/world/city_creation_tradition_rules.gd")
const Keys=preload("res://scripts/world/city_creation_stair_keys.gd")
const Travel=preload("res://scripts/world/city_creation_travel.gd")
static func run(tree:SceneTree,check:Callable)->void:
	for strength:float in [.8,1.]:
		var city:=Fixture.slope(strength);var travel:=Travel.new();travel.sync(city)
		var profile:Dictionary=city.road_profile(city.roads[0])
		check.call(not profile.treads.is_empty() and profile.treads.all(func(t):return t.rise>=.65 and t.rise<1.),"real authored sub-metre slope: "+str(strength))
		check.call(not travel.sites.values().any(func(s):return s.kind=="stair"),"ordinary shallow steps have no keys before card")
		check.call(Fixture.learn(city,"stone_step_carillon").ok,"actual authored stone card choice")
		travel.sync(city);var sites:Array=travel.sites.values().filter(func(s):return s.kind=="stair")
		check.call(not sites.is_empty() and sites.all(func(s):return absf(city.street_height(s.at)-s.height)<.001),"real shallow keys align with collision/navigation")
		if not sites.is_empty():
			var site:Dictionary=sites[0]
			check.call(travel.observe("resident/actual-crossing",site.at-site.axis*.08,site.at+site.axis*.08,0.).any(func(s):return s.id==site.id),"actual shallow-step crossing produces a note event")
		city.undo();travel.sync(city);check.call(not travel.sites.values().any(func(s):return s.kind=="stair"),"undo unlearns shallow acoustic geometry")
		city.redo();travel.sync(city);var copy:=State.new()
		check.call(copy.restore(JSON.parse_string(JSON.stringify(city.snapshot()))).ok,"shallow-key card restores through JSON")
		var restored:=Travel.new();restored.sync(copy);check.call(restored.sites==travel.sites,"redo and reload rederive same physical keys")
	var shore:=Fixture.shore();check.call(is_equal_approx(shore.water_clearance(Vector2(-30,-22)),5.5) and not shore.site_blessing("h1").blessed,"actual pond shoreline is 5.5 metres outside old radius")
	var life:=Life.new();tree.root.add_child(life);life.set_process(false);life.setup(shore)
	Fixture.learn(shore,"warm_hearth_ballad");life._sync()
	check.call(shore.site_blessing("h1").blessed and shore.bakery_status("h1").produced==2,"6 metre rule triggers real first-bake transition")
	var trees:RefCounted=preload("res://tools/fixtures/city_creation_juice_fixture.gd").wishes()
	life.free();life=Life.new();tree.root.add_child(life);life.set_process(false);life.setup(trees)
	Fixture.learn(trees,"sylvan_luthier_guild");life._sync()
	for i in range(2400):
		if life.workshop.workers[0].phase=="crafting":break
		life._process(.05)
	check.call(life.workshop.workers[0].phase=="crafting","onsite artisan waits on actual workbench")
	for at:Vector2 in [Vector2(-26,-25),Vector2(-29,-25)]:life.site_wishes.on_edit(trees.place_plant(at,"olive"))
	check.call(trees.workshop_status("h2").produced==1 and life.workshop.workers[0].phase=="to_target" and life.workshop.workers[0].carry.visible,"second physical tree immediately dispatches carrying artisan")
	var produced:int=trees.workshop_status("h2").produced;trees.undo();life._sync();trees.redo();life._sync()
	check.call(trees.workshop_status("h2").produced==produced,"two-tree burst survives undo without farming")
	life.free()
	var hydraulic:RefCounted=preload("res://tools/fixtures/city_creation_modern_fixture.gd").earned_city()
	hydraulic.set_house_role("h1","bakery");Fixture.learn(hydraulic,"hydraulic_guild")
	# Use an actual near-water bakery; no invented produce/stock counters.
	var at:=Vector2(hydraulic.houses[0].origin[0],hydraulic.houses[0].origin[1])
	hydraulic.add_water([at+Vector2(0,-4)] as Array[Vector2],2.,"pond")
	for i in range(3):check.call(hydraulic.produce_bread("h1",1),"real hydraulic bake")
	check.call(hydraulic.bakery_status("h1").produced==4 and hydraulic.bakery_status("h1").stock==4,"every third actual batch adds exactly one conserved gift")
	var reloaded:=State.new();check.call(reloaded.restore(JSON.parse_string(JSON.stringify(hydraulic.snapshot()))).ok,"gift inventory and batch receipt validate after JSON")
	check.call(reloaded.harmony_journey.receipts.get("hydraulic_batches/h1")==3,"batch cycle persists without new save schema")
	var art:RefCounted=preload("res://tools/fixtures/city_creation_modern_fixture.gd").earned_city();art.set_house_role("h1","atelier");Fixture.learn(art,"illuminated_atelier")
	check.call(art.produce_craft("h1",1) and art.reserve_craft("h1","h2","h2","art") and art.complete_craft("h1","h2","h2"),"real artist production reservation delivery")
	check.call(art.culture_level("h2")==2 and art.workshop_supply.h1.delivered==2 and art.workshop_supply.h1.produced==2,"one journey delivers two real decorative objects with exact conservation")
	check.call(State.new().restore(art.snapshot()).ok,"double artwork passes existing service and inventory validation")
	var bridge:RefCounted=preload("res://tools/fixtures/city_creation_modern_fixture.gd").earned_city()
	for id:String in ["h1","h2"]:bridge.set_house_era(id,"modern_eco");bridge.add_cell(id,0,0,1)
	bridge.set_house_role("h3","bakery");bridge.produce_bread("h3",1);bridge.serve_bread("h3","h1")
	preload("res://scripts/world/city_creation_quality.gd").refresh(bridge,{"h1":true,"h2":true},{})
	Fixture.learn(bridge,"cloud_gallery");var plans:Array=preload("res://scripts/world/city_creation_skybridge_plan.gd").for_house(bridge,bridge.houses[0])
	check.call(not plans.is_empty(),"card retains legal existing skybridge")
	var first:=int(bridge.building_quality.get("h1",{}).get("level_tier",1));var second:=int(bridge.building_quality.get("h2",{}).get("level_tier",1))
	var raw:Dictionary=bridge.building_quality.duplicate(true)
	check.call(bridge.level_tier("h1")==maxi(first,second) and bridge.level_tier("h2")==maxi(first,second) and first!=second and bridge.building_quality==raw,"connected bridge derives shared warmth without forging permanent services")
	check.call(Rules.bridge_distance(bridge)==9.,"cloud gallery widens legal centre gap to nine metres")
	var water:=Fixture.shore();Fixture.learn(water,"lasting_resonance")
	check.call(not preload("res://scripts/world/city_creation_quality.gd").amenity(water,water.houses[0]),"natural garden still respects actual shore radius")
	water.add_water([Vector2(-34,-24)] as Array[Vector2],2.,"pond")
	check.call(preload("res://scripts/world/city_creation_quality.gd").amenity(water,water.houses[0]),"real nearby water counts as natural flower amenity")

	var wood:RefCounted=preload("res://tools/fixtures/city_creation_juice_fixture.gd").wishes()
	for point:Vector2 in [Vector2(-35,-22),Vector2(-34,-27),Vector2(-35,-18)]:check.call(wood.place_plant(point,"olive").ok,"legal remote tree")
	check.call(not wood.site_blessing("h2").blessed and wood.site_blessing("h2").trees==0,"three remote trees are outside original eight metre circle")
	Fixture.learn(wood,"woodland_workbench")
	check.call(wood.site_blessing("h2").blessed and wood.site_blessing("h2").trees==3,"actual ten metre wood circle activates all three distant trees")
	var wider:RefCounted=preload("res://tools/fixtures/city_creation_modern_fixture.gd").earned_city()
	var pair:Array=[]
	for point:Vector2 in [Vector2(-35,8),Vector2(-26.5,8)]:
		var placed:Dictionary=wider.add_house(point);check.call(placed.ok,"legal wide-gap modern tower")
		pair.append(str(placed.house_id));wider.add_cell(str(placed.house_id),0,0,1);wider.set_house_era(str(placed.house_id),"modern_eco")
	var plan_api=preload("res://scripts/world/city_creation_skybridge_plan.gd")
	check.call(plan_api.for_house(wider,wider.houses[wider._house_index(pair[0])]).is_empty(),"actual 8.5 metre gap rejects legacy bridge")
	Fixture.learn(wider,"cloud_gallery")
	check.call(plan_api.for_house(wider,wider.houses[wider._house_index(pair[0])]).any(func(p):return p.to_house==pair[1]),"card builds actual 8.5 metre legal skybridge")

	var clockwork:RefCounted=preload("res://tools/fixtures/city_creation_modern_fixture.gd").earned_city()
	clockwork.set_house_role("h1","clockmaker")
	check.call(clockwork.produce_craft("h1",1) and clockwork.reserve_craft("h1","h2","h2","musicbox") and clockwork.complete_craft("h1","h2","h2"),"real clockmaker donation before expanding chime wave")
	var wave:={"h2":.8}
	check.call(Rules.chime_wave(clockwork,wave)==wave,"ordinary donated home does not extend unrelated wave")
	Fixture.learn(clockwork,"brass_orchard")
	var expanded:=Rules.chime_wave(clockwork,wave)
	check.call(clockwork.mechanism_level("h2")==1 and expanded.has("h4") and float(expanded.h4)>0. and wave.size()==1,"actual donated musicbox spreads chime movement to real neighbouring home without mutating source")
