# Godot 4+ specific ignores
.godot/
/android/
.mcp.json

# Original packages stay on disk; retain textual licensing evidence separately.
/资产/01_原始素材/CC0_Kenney/
/资产/01_原始素材/CC0_ambientCG/
/资产/01_原始素材/OFL_Fonts/
/资产/2.5D素材/

# Reproducible local Demo bundles; retain build evidence and source in Git.
/交付/

# Archived portable bundles remain local after the centralized archive move.
/废弃/交付/

# Local Python bytecode from evidence tooling.
/tools/__pycache__/

# Local archives, download caches and transient native compiler files.
/备份/
/废弃/
/addons/city_audio/bin/~*
/AI资料/*.tmp

# Native audio source and playable DLL are tracked; compiler intermediates are not.
/native/city_audio/.sconsign.dblite
/native/city_audio/src/*.obj
/native/city_audio/src/*.obj.import
/addons/city_audio/bin/*.exp
/addons/city_audio/bin/*.lib

# Standalone test scripts load by res:// path; editor-generated UIDs are not inputs.
/tests/*.gd.uid
/废弃/第181视觉前/import_uid_noise/

# Candidate art imports are regenerated by Godot from the checked-in SVG/PNG.
/资源/美术候选/**/*.import
/验证记录/round199_美术对照/**/*.import
/验证记录/round200_*/**/*.import
