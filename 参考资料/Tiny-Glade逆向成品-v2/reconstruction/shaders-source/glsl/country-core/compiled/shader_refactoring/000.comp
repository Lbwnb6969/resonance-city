#version 460
#extension GL_EXT_samplerless_texture_functions : require
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 1) uniform texture2D rendered_tex;
layout(set = 0, binding = 2, r11f_g11f_b10f) uniform writeonly image2D reference_tex;

void main()
{
    imageStore(reference_tex, ivec2(gl_GlobalInvocationID.xy), vec4(texelFetch(rendered_tex, ivec2(gl_GlobalInvocationID.xy), 0).xyz, 0.0));
}

