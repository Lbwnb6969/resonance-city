#version 460
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, std140) uniform GlobalParams_natural
{
    uvec2 output_tex_dims;
    float value;
} globalParams;

layout(set = 0, binding = 1, r8) uniform writeonly image2D output_tex;

void main()
{
    imageStore(output_tex, ivec2(gl_GlobalInvocationID.xy), vec4(globalParams.value));
}

