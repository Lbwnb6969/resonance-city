#version 460
#extension GL_EXT_samplerless_texture_functions : require
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 1) uniform texture2D path_mask;
layout(set = 0, binding = 2) uniform texture2D cobblestone1_mask;
layout(set = 0, binding = 3) uniform texture2D cobblestone2_mask;
layout(set = 0, binding = 4) uniform texture2D cobblestone3_mask;
layout(set = 0, binding = 5, r16f) uniform writeonly image2D paths_exclusion;

void main()
{
    uvec2 _15 = uvec2(ivec2(gl_GlobalInvocationID.xy));
    imageStore(paths_exclusion, ivec2(_15), vec4(clamp(((texelFetch(path_mask, ivec2(_15), 0).x + texelFetch(cobblestone1_mask, ivec2(_15), 0).x) + texelFetch(cobblestone2_mask, ivec2(_15), 0).x) + texelFetch(cobblestone3_mask, ivec2(_15), 0).x, 0.0, 1.0)));
}

