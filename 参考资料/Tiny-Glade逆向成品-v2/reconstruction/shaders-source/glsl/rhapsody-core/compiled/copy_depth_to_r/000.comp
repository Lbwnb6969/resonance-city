#version 460
#extension GL_EXT_samplerless_texture_functions : require
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 1) uniform texture2D input_tex;
layout(set = 0, binding = 2, r32f) uniform writeonly image2D output_tex;

void main()
{
    imageStore(output_tex, ivec2(gl_GlobalInvocationID.xy), vec4(texelFetch(input_tex, ivec2(gl_GlobalInvocationID.xy), 0).x));
}

