; SPIR-V 1.3
; SHA256 37f3f954e686b7f516264638a1c25ecd388cec63f7a7535c8602ebe00e160ae6
; Hex literal words are raw IEEE/integer bits; no external assembler validation.
OpCapability Shader ; byte 0x14
OpCapability StorageImageExtendedFormats ; byte 0x1c
OpMemoryModel Logical GLSL450 ; byte 0x24
OpEntryPoint Fragment %2 "main" ; byte 0x30
OpExecutionMode %2 OriginUpperLeft ; byte 0x44
OpSource Slang 1 ; byte 0x50
OpName %2 "ps_main" ; byte 0x5c
%1 = OpTypeVoid ; byte 0x6c
%3 = OpTypeFunction %1 ; byte 0x74
%2 = OpFunction %1 None %3 ; byte 0x80
%4 = OpLabel ; byte 0x94
OpReturn ; byte 0x9c
OpFunctionEnd ; byte 0xa0
