; SPIR-V 1.3
; SHA256 3a17980c57507265855ba10f11b391694dd2e29a88d8d512c3cc1e7c21ed2423
; Hex literal words are raw IEEE/integer bits; no external assembler validation.
OpCapability Shader ; byte 0x14
OpCapability StorageImageExtendedFormats ; byte 0x1c
OpMemoryModel Logical GLSL450 ; byte 0x24
OpEntryPoint GLCompute %2 "main" ; byte 0x30
OpExecutionMode %2 LocalSize 8 8 1 ; byte 0x44
OpSource Slang 1 ; byte 0x5c
OpName %2 "main" ; byte 0x68
%1 = OpTypeVoid ; byte 0x78
%3 = OpTypeFunction %1 ; byte 0x80
%2 = OpFunction %1 None %3 ; byte 0x8c
%4 = OpLabel ; byte 0xa0
OpReturn ; byte 0xa8
OpFunctionEnd ; byte 0xac
