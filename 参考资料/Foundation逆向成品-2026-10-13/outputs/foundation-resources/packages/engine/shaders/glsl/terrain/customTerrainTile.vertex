in vec3 attribPosition;
in vec4 attribColor;
in vec3 attribNormal;
in int attribCustomId;
in int attribCustomProperty;
uniform mat4 uniMatModel;
uniform mat4 uniPrevMatModel;
uniform mat4 uniMatViewProjection;
uniform mat4 uniPrevMatViewProjection;
uniform float uniVertexColorWeight;
uniform isamplerBuffer uniTileDataBuffer;
out vec3 WORLD_POSITION;
out vec3 LOCAL_POSITION;
out vec4 VERTEX_COLOR;
out vec3 NORMAL;
flat out int CUSTOM_PROPERTY;
out vec4 SCREEN_COORD;
out vec4 PREV_SCREEN_COORD;
flat out ivec3 TILE_DATA;

void main()
{
	int CUSTOM_ID = attribCustomId;
	CUSTOM_PROPERTY = attribCustomProperty;
	VERTEX_COLOR = mix(vec4(1), attribColor, uniVertexColorWeight);
	mat4 MODEL_MATRIX = uniMatModel;
	mat4 PREV_MODEL_MATRIX = uniPrevMatModel;
	mat4 MVP_MATRIX = uniMatViewProjection * MODEL_MATRIX;
	mat4 PREV_MVP_MATRIX = uniPrevMatViewProjection * PREV_MODEL_MATRIX;
	vec3 vertexPosition = attribPosition;
	vec3 prevVertexPosition = vertexPosition;
	vec3 LOCAL_NORMAL = attribNormal;
	LOCAL_POSITION = vertexPosition;
	WORLD_POSITION = ((MODEL_MATRIX) * vec4(LOCAL_POSITION, 1.0)).xyz;
	NORMAL = ((MODEL_MATRIX) * vec4(LOCAL_NORMAL, 0.0)).xyz;
	SCREEN_COORD = MVP_MATRIX * vec4(vertexPosition, 1.0);
	PREV_SCREEN_COORD = PREV_MVP_MATRIX * vec4(prevVertexPosition, 1.0);
	TILE_DATA = texelFetch(uniTileDataBuffer, CUSTOM_ID).xyz;
}