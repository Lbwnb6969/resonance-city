
uniform mat4 uniViewProjectionInverse;
uniform sampler2D uniTextureDiffuse;
uniform sampler2D uniTextureDepth;

uniform float uniSdfRange;
uniform ivec2 uniTerrainSize;
uniform int uniMode;
uniform int uniStencilSelectionMask;
uniform int uniStencilDiscardMask;
uniform float uniPreviewPatternRepeat;

#define MAX_LAYER_COUNT 5
uniform sampler2D uniTextureLayerSdf[MAX_LAYER_COUNT - 1];
uniform sampler2D uniTexturePreviewPattern;
uniform usampler2D uniTextureStencil;

uniform vec4 uniLayerColor[MAX_LAYER_COUNT];
uniform int uniLayerBlendType[MAX_LAYER_COUNT];
uniform vec3 uniLayerCSB[MAX_LAYER_COUNT]; // Contrast, Saturation, Brightness

in vec2 varUv;

layout(location = 0) out vec4 outAlbedoColor;

//------------------------------------------------------------------------
vec3 linearToGamma(vec3 color) { return pow(color, vec3(1.0 / 2.2)); }
vec3 gammaToLinear(vec3 color) { return pow(color, vec3(2.2)); }

//------------------------------------------------------------------------
// rgb<-->hsv functions by Sam Hocevar
// http://lolengine.net/blog/2013/07/27/rgb-to-hsv-in-glsl
vec3 rgb2hsv(vec3 c)
{
	vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
	vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));
	vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));

	float d = q.x - min(q.w, q.y);
	float e = 1.0e-10;
	return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
}

float rgb2hsv_v(vec3 c)
{
	float px = mix(c.b, c.g, step(c.b, c.g));
	float qx = mix(px, c.r, step(px, c.r));
	return qx;
}

//------------------------------------------------------------------------
vec3 hsv2rgb(vec3 c)
{
	vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
	vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
	return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
}

//------------------------------------------------------------------------
float grayscale(vec3 color)
{
	// Relative luminance in gamma encoded colorspaces
	// https://en.wikipedia.org/wiki/Relative_luminance
	const vec3 luminosityFactor = vec3(0.2126, 0.7152, 0.0722);
	return dot(color, luminosityFactor);
}

//------------------------------------------------------------------------
vec3 sepia(vec3 color)
{
	// Sepia coefficients
	// https://www.geeksforgeeks.org/image-processing-in-java-colored-image-to-sepia-image-conversion/
	const mat3 sepiaCoefficientMatrix = mat3(
  		0.393, 0.769, 0.189,
 		0.349, 0.686, 0.168,
 		0.272, 0.534, 0.131);
	return color * sepiaCoefficientMatrix;
}

//------------------------------------------------------------------------
vec3 layerBlendColorDodge(vec3 a, vec3 b)
{
	return b / (1 - a);
}

//------------------------------------------------------------------------
vec3 layerBlendColorBurn(vec3 a, vec3 b)
{
	return 1 - (1 - b) / a;
}

//------------------------------------------------------------------------
float layerBlendVividLight(float a, float b)
{
	return (a < 0.5) ? 1.0 - (1.0 - b) / (2.0 * a) : b / (2.0 * (1.0 - a));
}

//------------------------------------------------------------------------
vec3 layerBlendVividLight(vec3 a, vec3 b)
{
	return vec3(layerBlendVividLight(a.r, b.r), layerBlendVividLight(a.g, b.g), layerBlendVividLight(a.b, b.b));
}

//------------------------------------------------------------------------
vec3 layerBlendColor(vec3 a, vec3 b)
{
	a = rgb2hsv(a);
	a.z = rgb2hsv_v(b);
	return hsv2rgb(a);
}

//------------------------------------------------------------------------
vec3 adjustContrast(vec3 color, float value)
{
  return 0.5 + value * (color - 0.5);
}

//------------------------------------------------------------------------
vec3 adjustSaturation(vec3 color, float value)
{
	return mix(vec3(grayscale(color)), color, 1.0 + value);
}

//------------------------------------------------------------------------
vec3 adjustBrightness(vec3 color, float value)
{
	return color + value;
}

//------------------------------------------------------------------------
vec3 processLayer(vec3 baseColor, uint layerIndex)
{
	vec3 result = baseColor;
	uint blendMode = uniLayerBlendType[layerIndex];

	if (blendMode == BLEND_MODE_GRAYSCALE)
	{
		result = vec3(grayscale(uniLayerColor[layerIndex].rgb));
	}
	else if (blendMode == BLEND_MODE_SEPIA)
	{
		result = sepia(uniLayerColor[layerIndex].rgb);
		result = layerBlendColor(result, baseColor);
	}
	else if (blendMode == BLEND_MODE_COLOR_DODGE)
	{
		result = layerBlendColorDodge(uniLayerColor[layerIndex].rgb, baseColor);
	}
	else if (blendMode == BLEND_MODE_COLOR_BURN)
	{
		result = layerBlendColorBurn(uniLayerColor[layerIndex].rgb, baseColor);
	}
	else if (blendMode == BLEND_MODE_VIVID_LIGHT)
	{
		result = layerBlendVividLight(uniLayerColor[layerIndex].rgb, baseColor);
	}
	else if (blendMode == BLEND_MODE_COLOR)
	{
		result = layerBlendColor(uniLayerColor[layerIndex].rgb, baseColor);
	}
	else
	{
		return vec3(1, 0, 0); // Unknown blend mode, return RED
	}

	result = mix(baseColor, result, uniLayerColor[layerIndex].a);
	result = adjustContrast(result, uniLayerCSB[layerIndex].x);
	result = adjustSaturation(result, uniLayerCSB[layerIndex].y);
	result = adjustBrightness(result, uniLayerCSB[layerIndex].z);

	return result;
}

//------------------------------------------------------------------------
void main()
{
	vec4 COLOR = texture2D(uniTextureDiffuse, varUv);
	float DEPTH = texture2D(uniTextureDepth, varUv).r;
	vec3 ALBEDO = COLOR.rgb;
	vec4 screenPosition = vec4(varUv * 2.0 - 1.0, DEPTH * 2.0 - 1.0, 1.0);
	vec4 worldPosition = uniViewProjectionInverse * screenPosition;
	vec3 POSITION = worldPosition.xyz / worldPosition.w;

	vec2 uvWorld = POSITION.xz / uniTerrainSize;
	uvWorld = clamp(uvWorld, vec2(0), vec2(1)); // clamp to avoid artifact on the skybox

	uint stencil = texture(uniTextureStencil, varUv).r;

	vec3 initialColor = linearToGamma(COLOR.rgb);
	COLOR.rgb = initialColor;

	vec3 colBackground = COLOR.rgb;

	if ((stencil & uniStencilDiscardMask) == 0x0)
	{
		colBackground = processLayer(COLOR.rgb, 0);
	}

	if (uniMode == MODE_SIMPLE || uniMode == MODE_SIMPLE_WITH_INACTIVE)
	{
		vec3 colorLayer = processLayer(COLOR.rgb, 1);
		vec3 colorPreviewLayer = processLayer(COLOR.rgb, 2);

		// compute zone bitfield
		vec2 sdf2 = vec2(
			texture2D(uniTextureLayerSdf[0], uvWorld).r,
			texture2D(uniTextureLayerSdf[1], uvWorld).r);
		sdf2 = sdf2 * uniSdfRange * 2 - uniSdfRange;
		vec2 step2 = 1 - step(0, sdf2);
		float layerWeight = step2.x;
		float previewLayerWeight = step2.y;

		COLOR.rgb = colBackground;

		if((stencil & uniStencilSelectionMask) != 0x0)
		{
			// Background VS Layer Preview
			COLOR.rgb = mix(colBackground, colorPreviewLayer, previewLayerWeight);

			// Add Non-Preview
			COLOR.rgb = mix(COLOR.rgb, colorLayer, layerWeight);

			// Add Inactive
			if (uniMode == MODE_SIMPLE_WITH_INACTIVE)
			{
				vec3 colorInactive = processLayer(initialColor.rgb, 3);
				vec3 colorInactivePreview = processLayer(initialColor.rgb, 4);

				float sdfInactive = texture2D(uniTextureLayerSdf[3], uvWorld).r;
				sdfInactive = sdfInactive * uniSdfRange * 2 - uniSdfRange;
				float inactiveLayerWeight = 1 - step(0, sdfInactive);

				COLOR.rgb = mix(COLOR.rgb, colorInactivePreview, inactiveLayerWeight * previewLayerWeight);
				COLOR.rgb = mix(COLOR.rgb, colorInactive, inactiveLayerWeight * layerWeight);
			}
		}
	}
	else if (uniMode == MODE_TWO_LEVELS)
	{
		vec3 colorLayerLvl1 = processLayer(COLOR.rgb, 1);
		vec3 colorPreviewLayerLvl1 = processLayer(COLOR.rgb, 2);
		vec3 colorLayerLvl2 = processLayer(COLOR.rgb, 3);
		vec3 colorPreviewLayerLvl2 = processLayer(COLOR.rgb, 4);

		// compute zone bitfield
		vec4 sdf4 = vec4(
			texture2D(uniTextureLayerSdf[0], uvWorld).r,
			texture2D(uniTextureLayerSdf[1], uvWorld).r,
			texture2D(uniTextureLayerSdf[2], uvWorld).r,
			texture2D(uniTextureLayerSdf[3], uvWorld).r);
		sdf4 = sdf4 * uniSdfRange * 2 - uniSdfRange;
		vec4 step4 = 1 - step(0, sdf4);
		float layerLvl1Weight = step4.x;
		float previewLayerLvl1Weight = step4.y;
		float layerLvl2Weight = step4.z;
		float previewLayerLvl2Weight = step4.w;

		/*
		// Background VS Layer Preview Lvl1
		COLOR.rgb = mix(colBackground, colorPreviewLayerLvl1, previewLayerLvl1Weight);

		// Add Non-Preview Lvl1
		COLOR.rgb = mix(COLOR.rgb, colorLayerLvl1, layerLvl1Weight);

		// Add Preview Lvl2
		COLOR.rgb = mix(COLOR.rgb, colorPreviewLayerLvl2, previewLayerLvl2Weight);

		// Add Non-Preview Lvl2
		COLOR.rgb = mix(COLOR.rgb, colorLayerLvl2, layerLvl2Weight);

		/*/COLOR.rgb = colBackground;

		if((stencil & uniStencilSelectionMask) != 0x0)
		{
			float previewPattern = texture2D(uniTexturePreviewPattern, POSITION.xz / uniPreviewPatternRepeat).r;

			// Background VS Layer Preview Lvl1
			COLOR.rgb = mix(COLOR.rgb, colorPreviewLayerLvl1, previewLayerLvl1Weight * previewPattern);

			// Add Non-Preview Lvl1
			COLOR.rgb = mix(COLOR.rgb, colorLayerLvl1, layerLvl1Weight);

			// Add Preview Lvl2
			COLOR.rgb = mix(COLOR.rgb, colorPreviewLayerLvl2, previewLayerLvl2Weight * previewPattern);

			// Add Non-Preview Lvl2
			COLOR.rgb = mix(COLOR.rgb, colorLayerLvl2, layerLvl2Weight);
		}//*/
	}
	else if (uniMode == MODE_RESIDENTIAL)
	{
		vec3 colorDesirability1 = processLayer(COLOR.rgb, 1);
		vec3 colorDesirability2 = processLayer(COLOR.rgb, 2);
		vec3 colorUndesirable = processLayer(COLOR.rgb, 3);

		// compute zone bitfield
		vec3 sdf3 = vec3(
			texture2D(uniTextureLayerSdf[0], uvWorld).r,
			texture2D(uniTextureLayerSdf[1], uvWorld).r,
			texture2D(uniTextureLayerSdf[2], uvWorld).r);

		sdf3 = sdf3 * uniSdfRange * 2 - uniSdfRange;
		vec3 step3 = 1 - step(0, sdf3);

		// compute main zone info
		float undesirable = step3[2];
		float desirability1 = step3[0];
		float desirability2 = step(1.5, desirability1 + step3[1]);

		// Background VS Desirability 1
		COLOR.rgb = mix(colBackground, colorDesirability1, desirability1);

		// Add Desirability 2
		COLOR.rgb = mix(COLOR.rgb, colorDesirability2, desirability2);

		// Add Undesirable
		COLOR.rgb = mix(COLOR.rgb, colorUndesirable, undesirable);
		//COLOR.rgb = mix(COLOR.rgb, colorUndesirable * vec3(1, 0.7, 0.7), sdf3.b > -0.5 && sdf3.b < 0); // outline
	}

	COLOR.rgb = gammaToLinear(COLOR.rgb);
	outAlbedoColor = COLOR;
}