uniform vec3 uniCameraPosition;
in vec3 WORLD_POSITION[];
out vec3 tess_WORLD_POSITION[];
in vec3 LOCAL_POSITION[];
out vec3 tess_LOCAL_POSITION[];
in vec4 VERTEX_COLOR[];
out vec4 tess_VERTEX_COLOR[];
in vec3 NORMAL[];
out vec3 tess_NORMAL[];
flat in int CUSTOM_PROPERTY[];
in vec4 SCREEN_COORD[];
out vec4 tess_SCREEN_COORD[];
in vec4 PREV_SCREEN_COORD[];
out vec4 tess_PREV_SCREEN_COORD[];
flat in ivec3 TILE_DATA[];
flat out ivec3 tess_TILE_DATA[];
out float tess_HEIGHT_MAP_FACTOR[];

layout (vertices = 3) out;

void main()
{
	tess_WORLD_POSITION[gl_InvocationID] = WORLD_POSITION[gl_InvocationID];
	tess_LOCAL_POSITION[gl_InvocationID] = LOCAL_POSITION[gl_InvocationID];
	tess_VERTEX_COLOR[gl_InvocationID] = VERTEX_COLOR[gl_InvocationID];
	tess_NORMAL[gl_InvocationID] = NORMAL[gl_InvocationID];
	tess_SCREEN_COORD[gl_InvocationID] = SCREEN_COORD[gl_InvocationID];
	tess_PREV_SCREEN_COORD[gl_InvocationID] = PREV_SCREEN_COORD[gl_InvocationID];
	tess_TILE_DATA[gl_InvocationID] = TILE_DATA[gl_InvocationID];

	for(int i = 0; i < 3; ++ i)
	{
		gl_TessLevelOuter[i] = 1.0;
	}
	gl_TessLevelInner[0] = (gl_TessLevelOuter[0] + gl_TessLevelOuter[1] + gl_TessLevelOuter[2]) / 3.0;
	float eyeToVertexDistance0 = distance(uniCameraPosition, WORLD_POSITION[0]);
	float eyeToVertexDistance1 = distance(uniCameraPosition, WORLD_POSITION[1]);
	float eyeToVertexDistance2 = distance(uniCameraPosition, WORLD_POSITION[2]);
	float length0 = distance(WORLD_POSITION[1], WORLD_POSITION[2]);
	float length1 = distance(WORLD_POSITION[2], WORLD_POSITION[0]);
	float length2 = distance(WORLD_POSITION[0], WORLD_POSITION[1]);
	float lengthFactor = length0 / 16.0;
	float avgDistance = (eyeToVertexDistance1 + eyeToVertexDistance2) * 0.5;
	float tess = clamp((avgDistance - 5), 0, 800) / lengthFactor;
	tess = (800 * lengthFactor) / tess;
	gl_TessLevelOuter[0] = min(2 + tess, 64);
	float lengthFactor_1 = length1 / 16.0;
	float avgDistance_1 = (eyeToVertexDistance2 + eyeToVertexDistance0) * 0.5;
	float tess_1 = clamp((avgDistance_1 - 5), 0, 800) / lengthFactor_1;
	tess_1 = (800 * lengthFactor_1) / tess_1;
	gl_TessLevelOuter[1] = min(2 + tess_1, 64);
	float lengthFactor_2 = length2 / 16.0;
	float avgDistance_2 = (eyeToVertexDistance0 + eyeToVertexDistance1) * 0.5;
	float tess_2 = clamp((avgDistance_2 - 5), 0, 800) / lengthFactor_2;
	tess_2 = (800 * lengthFactor_2) / tess_2;
	gl_TessLevelOuter[2] = min(2 + tess_2, 64);
	gl_TessLevelInner[0] = max(max(gl_TessLevelOuter[0], gl_TessLevelOuter[1]), gl_TessLevelOuter[2]);
	int VERTEX_PROPERTY_FLAG_IS_CUSTOM_SHAPE = 0x1;
	int VERTEX_PROPERTY_FLAG_OFFSET_IS_CUSTOM_SHAPE = 0;
	tess_HEIGHT_MAP_FACTOR[gl_InvocationID] = 1.0 * ((~ CUSTOM_PROPERTY[gl_InvocationID] & VERTEX_PROPERTY_FLAG_IS_CUSTOM_SHAPE) >> VERTEX_PROPERTY_FLAG_OFFSET_IS_CUSTOM_SHAPE);
	bool vert0CustomMesh = (CUSTOM_PROPERTY[0] & VERTEX_PROPERTY_FLAG_IS_CUSTOM_SHAPE) != 0x0;
	bool vert1CustomMesh = (CUSTOM_PROPERTY[1] & VERTEX_PROPERTY_FLAG_IS_CUSTOM_SHAPE) != 0x0;
	bool vert2CustomMesh = (CUSTOM_PROPERTY[2] & VERTEX_PROPERTY_FLAG_IS_CUSTOM_SHAPE) != 0x0;
	if(vert1CustomMesh && vert2CustomMesh) {
		{
			gl_TessLevelOuter[0] = 1.0;
		}
	}
	if(vert2CustomMesh && vert0CustomMesh) {
		{
			gl_TessLevelOuter[1] = 1.0;
		}
	}
	if(vert0CustomMesh && vert1CustomMesh) {
		{
			gl_TessLevelOuter[2] = 1.0;
		}
	}
	gl_TessLevelInner[0] = (gl_TessLevelOuter[0] + gl_TessLevelOuter[1] + gl_TessLevelOuter[2]) / 3.0;
}