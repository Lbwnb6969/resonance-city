in vec4 var_attribColor;
layout(location = 0) out vec4 outColor;

void main()
{
	vec4 ATTRIB_COLOR = var_attribColor;
	vec4 COLOR = vec4(1);
	COLOR = ATTRIB_COLOR;
	outColor = COLOR;
	float hue = outColor.r * 6.0;
	float saturation = outColor.g;
	float brightness = outColor.b;
	float c = brightness * saturation;
	float x = c * (1 - abs(mod(hue, 2.0) - 1));
	float m = brightness - c;
	if(hue < 1.0) {
		{
			outColor.rgb = vec3(c, x, 0);
		}
	} else {
		if(hue < 2.0) {
			{
				outColor.rgb = vec3(x, c, 0);
			}
		} else {
			if(hue < 3.0) {
				{
					outColor.rgb = vec3(0, c, x);
				}
			} else {
				if(hue < 4.0) {
					{
						outColor.rgb = vec3(0, x, c);
					}
				} else {
					if(hue < 5.0) {
						{
							outColor.rgb = vec3(x, 0, c);
						}
					} else {
						{
							outColor.rgb = vec3(c, 0, x);
						}
					}				}			}		}	}	outColor.rgb += m;
}