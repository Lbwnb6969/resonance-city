uniform sampler2DArray uniTextureArrayDiffuse;
uniform sampler2DArray uniFontTextureArrayDiffuse;
in vec3 var_attribUv3d;
in vec4 var_attribColor;
in float var_attribSdfWidthThreshold;
flat in float var_attribSdfSoftnessWidth;
layout(location = 0) out vec4 outColor;

void main()
{
	vec4 ATTRIB_COLOR = var_attribColor;
	vec4 TEXTURE_COLOR = vec4(1);
	vec4 COLOR = vec4(1);
	if(var_attribSdfWidthThreshold == 0.0) {
		{
			int mode = floatBitsToInt(var_attribSdfSoftnessWidth);
			TEXTURE_COLOR = texture(uniTextureArrayDiffuse, var_attribUv3d);
			if(mode == 1) {
				{
					COLOR = vec4(ATTRIB_COLOR.rgb * TEXTURE_COLOR.a, 0) + TEXTURE_COLOR;
				}
			} else {
				{
					COLOR = ATTRIB_COLOR * TEXTURE_COLOR;
				}
			}		}
	} else {
		{
			vec4 texSample;
			texSample = texture(uniFontTextureArrayDiffuse, var_attribUv3d);
			float alpha = 0.0;
			if(var_attribSdfWidthThreshold > 0.0) {
				{
					float dist = max(min(texSample.r, texSample.g), min(max(texSample.r, texSample.g), texSample.b));
					float smoothModifier = 1.0;
					dist = (dist - var_attribSdfWidthThreshold) * var_attribSdfSoftnessWidth;
					alpha = smoothstep(- 1.0 * smoothModifier, smoothModifier, dist);
				}
			} else {
				{
					float dist_1 = texSample.a;
					dist_1 = (dist_1 - abs(var_attribSdfWidthThreshold)) * var_attribSdfSoftnessWidth;
					alpha = clamp((dist_1 / 2.0) + 0.5, 0.0, 1.0);
					alpha = pow(alpha, 1.5);
				}
			}			TEXTURE_COLOR = vec4(alpha);
			COLOR = ATTRIB_COLOR * alpha;
		}
	}	COLOR.rgb *= ATTRIB_COLOR.a;
	outColor = COLOR;
}