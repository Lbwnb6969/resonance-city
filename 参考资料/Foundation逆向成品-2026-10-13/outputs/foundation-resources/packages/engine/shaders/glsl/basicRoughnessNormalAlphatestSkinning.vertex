in vec3 attribPosition;
in vec2 attribUv;
in vec4 attribColor;
in vec3 attribNormal;
in vec3 attribTangent;
in vec3 attribBiTangent;
in vec4 attribBoneWeight;
in ivec4 attribBoneId;
in uvec4 instDataPacked;
uniform mat4 uniMatModel;
uniform mat4 uniMatViewProjection;
uniform float uniVertexColorWeight;
uniform samplerBuffer uniBoneMatrixBuffer;
uniform vec2 uniCameraJitter;
out vec4 VERTEX_COLOR;
out vec3 NORMAL;
out vec3 TANGENT;
out vec3 BITANGENT;
out vec2 UV;

void main()
{
	VERTEX_COLOR = mix(vec4(1), attribColor, uniVertexColorWeight);
	mat4 MODEL_MATRIX = uniMatModel;
	mat4 MVP_MATRIX = uniMatViewProjection * MODEL_MATRIX;
	vec3 vertexPosition = attribPosition;
	vec3 LOCAL_NORMAL = attribNormal;
	vec3 vertexTangent = attribTangent;
	vec3 vertexBiTangent = attribBiTangent;
	UV = attribUv;
	int instanceBoneOffset = int(instDataPacked.z);
	ivec4 offset = (attribBoneId + instanceBoneOffset) * 8;
	mat4 modifier01 = mat4(texelFetch(uniBoneMatrixBuffer, offset.x), texelFetch(uniBoneMatrixBuffer, offset.x + 1), texelFetch(uniBoneMatrixBuffer, offset.x + 2), texelFetch(uniBoneMatrixBuffer, offset.x + 3));
	mat4 modifier02 = mat4(texelFetch(uniBoneMatrixBuffer, offset.y), texelFetch(uniBoneMatrixBuffer, offset.y + 1), texelFetch(uniBoneMatrixBuffer, offset.y + 2), texelFetch(uniBoneMatrixBuffer, offset.y + 3));
	mat4 modifier03 = mat4(texelFetch(uniBoneMatrixBuffer, offset.z), texelFetch(uniBoneMatrixBuffer, offset.z + 1), texelFetch(uniBoneMatrixBuffer, offset.z + 2), texelFetch(uniBoneMatrixBuffer, offset.z + 3));
	mat4 modifier04 = mat4(texelFetch(uniBoneMatrixBuffer, offset.w), texelFetch(uniBoneMatrixBuffer, offset.w + 1), texelFetch(uniBoneMatrixBuffer, offset.w + 2), texelFetch(uniBoneMatrixBuffer, offset.w + 3));
	mat4 modifier = modifier01 * attribBoneWeight.x + modifier02 * attribBoneWeight.y + modifier03 * attribBoneWeight.z + modifier04 * attribBoneWeight.w;
	vec4 modifiedPosition = modifier * vec4(vertexPosition, 1.0);
	LOCAL_NORMAL = (modifier * vec4(LOCAL_NORMAL, 0.0)).xyz;
	vec4 modifiedTangent = modifier * vec4(vertexTangent, 0.0);
	vec4 modifiedBiTangent = modifier * vec4(vertexBiTangent, 0.0);
	NORMAL = (MODEL_MATRIX * vec4(LOCAL_NORMAL, 0)).xyz;
	TANGENT = (MODEL_MATRIX * modifiedTangent).xyz;
	BITANGENT = (MODEL_MATRIX * modifiedBiTangent).xyz;
	vec4 SCREEN_COORD = MVP_MATRIX * modifiedPosition;
	SCREEN_COORD.xy += uniCameraJitter * SCREEN_COORD.w;
	gl_Position = SCREEN_COORD;
}