uniform sampler2D uniTextureDiffuse;
uniform float uniBrightThreshold;
uniform float uniBrightMultiplier;
in vec4 POSITION;
layout(location = 0) out vec4 outColor;

void main()
{
	vec4 COLOR = texture(uniTextureDiffuse, POSITION.xy * 0.5 + 0.5);
	float brightness = dot(COLOR.rgb, vec3(0.2126, 0.7152, 0.0722));
	outColor = vec4(step(uniBrightThreshold, brightness) * (COLOR.rgb - uniBrightThreshold) * uniBrightMultiplier, COLOR.a);
}