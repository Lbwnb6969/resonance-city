uniform sampler2DArray uniTextureArrayDiffuse;
uniform sampler2D uniTextureBackground;
uniform float uniBackgroundAlpha;
uniform vec4 uniBackgroundTransform;
in vec3 var_attribUv3d;
in vec4 var_attribColor;
in vec4 POSITION;
layout(location = 0) out vec4 outColor;

void main()
{
	vec4 ATTRIB_COLOR = var_attribColor;
	vec4 TEXTURE_COLOR = vec4(1);
	vec4 COLOR = vec4(1);
	TEXTURE_COLOR = texture(uniTextureArrayDiffuse, var_attribUv3d);
	COLOR = ATTRIB_COLOR * TEXTURE_COLOR;
	COLOR.rgb *= ATTRIB_COLOR.a;
	outColor = COLOR;
	float bgAlpha = ATTRIB_COLOR.a * uniBackgroundAlpha;
	vec2 screenUv = uniBackgroundTransform.xy + (POSITION.xy + 1.0) * 0.5 * uniBackgroundTransform.zw;
	vec3 blurBackground = texture(uniTextureBackground, screenUv).rgb;
	blurBackground *= outColor.a;
	outColor.rgb *= bgAlpha;
	outColor.rgb += blurBackground * (1 - bgAlpha);
	outColor.a = TEXTURE_COLOR.a;
}