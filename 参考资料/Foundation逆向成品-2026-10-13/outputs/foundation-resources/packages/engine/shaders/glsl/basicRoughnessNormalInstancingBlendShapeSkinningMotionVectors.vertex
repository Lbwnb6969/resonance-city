in vec3 attribPosition;
in vec2 attribUv;
in vec4 attribColor;
in vec3 attribNormal;
in vec3 attribTangent;
in vec3 attribBiTangent;
in vec4 attribBoneWeight;
in ivec4 attribBoneId;
in vec4 instMatModel0;
in vec4 instMatModel1;
in vec4 instMatModel2;
in vec4 instPrevMatModel0;
in vec4 instPrevMatModel1;
in vec4 instPrevMatModel2;
in uvec4 instDataPacked;
uniform mat4 uniMatViewProjection;
uniform mat4 uniPrevMatViewProjection;
uniform float uniVertexColorWeight;
uniform samplerBuffer uniBoneMatrixBuffer;
uniform samplerBuffer uniBlendShapeBuffer;
uniform samplerBuffer uniBlendShapeWeightBuffer;
uniform isamplerBuffer uniBlendShapeIdBuffer;
uniform int uniBlendShapeCount;
uniform int uniBlendShapeBufferOffset;
uniform vec2 uniCameraJitter;
flat out uint MATERIAL_ID;
out vec4 INSTANCE_COLOR;
out vec4 VERTEX_COLOR;
out vec3 NORMAL;
out vec3 TANGENT;
out vec3 BITANGENT;
out vec2 UV;
out vec4 PREV_SCREEN_COORD;
out vec4 UNJITERRED_SCREEN_POSITION;

void main()
{
	VERTEX_COLOR = mix(vec4(1), attribColor, uniVertexColorWeight);
	mat4 MODEL_MATRIX = mat4(instMatModel0.x, instMatModel0.y, instMatModel0.z, 0, instMatModel0.w, instMatModel1.x, instMatModel1.y, 0, instMatModel1.z, instMatModel1.w, instMatModel2.x, 0, instMatModel2.y, instMatModel2.z, instMatModel2.w, 1);
	mat4 PREV_MODEL_MATRIX = mat4(instPrevMatModel0.x, instPrevMatModel0.y, instPrevMatModel0.z, 0, instPrevMatModel0.w, instPrevMatModel1.x, instPrevMatModel1.y, 0, instPrevMatModel1.z, instPrevMatModel1.w, instPrevMatModel2.x, 0, instPrevMatModel2.y, instPrevMatModel2.z, instPrevMatModel2.w, 1);
	MATERIAL_ID = instDataPacked.x;
	INSTANCE_COLOR = vec4((instDataPacked.y & 0x000000ff), (instDataPacked.y & 0x0000ff00) >> 8, (instDataPacked.y & 0x00ff0000) >> 16, (instDataPacked.y & 0xff000000) >> 24) / 255.0;
	mat4 MVP_MATRIX = uniMatViewProjection * MODEL_MATRIX;
	mat4 PREV_MVP_MATRIX = uniPrevMatViewProjection * PREV_MODEL_MATRIX;
	vec3 vertexPosition = attribPosition;
	vec3 prevVertexPosition = vertexPosition;
	vec3 LOCAL_NORMAL = attribNormal;
	vec3 vertexTangent = attribTangent;
	vec3 vertexBiTangent = attribBiTangent;
	UV = attribUv;
	for(int i = 0; i < uniBlendShapeCount; ++ i)
	{
		int bufferIndex = uniBlendShapeBufferOffset + gl_InstanceID * uniBlendShapeCount + i;
		vec2 weight = texelFetch(uniBlendShapeWeightBuffer, bufferIndex).xy;
		if(weight.x > 0 || weight.y > 0) {
			{
				int id = texelFetch(uniBlendShapeIdBuffer, bufferIndex).x;
				vec3 vertexOffset = texelFetch(uniBlendShapeBuffer, gl_VertexID + id).xyz;
				vertexPosition += vertexOffset * weight.x;
				prevVertexPosition += vertexOffset * weight.y;
			}
		}
	}
	int instanceBoneOffset = int(instDataPacked.z);
	ivec4 offset = (attribBoneId + instanceBoneOffset) * 8;
	mat4 modifier01 = mat4(texelFetch(uniBoneMatrixBuffer, offset.x), texelFetch(uniBoneMatrixBuffer, offset.x + 1), texelFetch(uniBoneMatrixBuffer, offset.x + 2), texelFetch(uniBoneMatrixBuffer, offset.x + 3));
	mat4 modifier02 = mat4(texelFetch(uniBoneMatrixBuffer, offset.y), texelFetch(uniBoneMatrixBuffer, offset.y + 1), texelFetch(uniBoneMatrixBuffer, offset.y + 2), texelFetch(uniBoneMatrixBuffer, offset.y + 3));
	mat4 modifier03 = mat4(texelFetch(uniBoneMatrixBuffer, offset.z), texelFetch(uniBoneMatrixBuffer, offset.z + 1), texelFetch(uniBoneMatrixBuffer, offset.z + 2), texelFetch(uniBoneMatrixBuffer, offset.z + 3));
	mat4 modifier04 = mat4(texelFetch(uniBoneMatrixBuffer, offset.w), texelFetch(uniBoneMatrixBuffer, offset.w + 1), texelFetch(uniBoneMatrixBuffer, offset.w + 2), texelFetch(uniBoneMatrixBuffer, offset.w + 3));
	int _offset = offset.x + 4;
	mat4 prevModifier01 = mat4(texelFetch(uniBoneMatrixBuffer, _offset), texelFetch(uniBoneMatrixBuffer, _offset + 1), texelFetch(uniBoneMatrixBuffer, _offset + 2), texelFetch(uniBoneMatrixBuffer, _offset + 3));
	int _offset_1 = offset.y + 4;
	mat4 prevModifier02 = mat4(texelFetch(uniBoneMatrixBuffer, _offset_1), texelFetch(uniBoneMatrixBuffer, _offset_1 + 1), texelFetch(uniBoneMatrixBuffer, _offset_1 + 2), texelFetch(uniBoneMatrixBuffer, _offset_1 + 3));
	int _offset_2 = offset.z + 4;
	mat4 prevModifier03 = mat4(texelFetch(uniBoneMatrixBuffer, _offset_2), texelFetch(uniBoneMatrixBuffer, _offset_2 + 1), texelFetch(uniBoneMatrixBuffer, _offset_2 + 2), texelFetch(uniBoneMatrixBuffer, _offset_2 + 3));
	int _offset_3 = offset.w + 4;
	mat4 prevModifier04 = mat4(texelFetch(uniBoneMatrixBuffer, _offset_3), texelFetch(uniBoneMatrixBuffer, _offset_3 + 1), texelFetch(uniBoneMatrixBuffer, _offset_3 + 2), texelFetch(uniBoneMatrixBuffer, _offset_3 + 3));
	mat4 modifier = modifier01 * attribBoneWeight.x + modifier02 * attribBoneWeight.y + modifier03 * attribBoneWeight.z + modifier04 * attribBoneWeight.w;
	mat4 prevModifier = prevModifier01 * attribBoneWeight.x + prevModifier02 * attribBoneWeight.y + prevModifier03 * attribBoneWeight.z + prevModifier04 * attribBoneWeight.w;
	vec4 modifiedPosition = modifier * vec4(vertexPosition, 1.0);
	LOCAL_NORMAL = (modifier * vec4(LOCAL_NORMAL, 0.0)).xyz;
	vec4 modifiedTangent = modifier * vec4(vertexTangent, 0.0);
	vec4 modifiedBiTangent = modifier * vec4(vertexBiTangent, 0.0);
	vec4 prevModifiedPosition = prevModifier * vec4(prevVertexPosition, 1.0);
	NORMAL = (MODEL_MATRIX * vec4(LOCAL_NORMAL, 0)).xyz;
	TANGENT = (MODEL_MATRIX * modifiedTangent).xyz;
	BITANGENT = (MODEL_MATRIX * modifiedBiTangent).xyz;
	vec4 SCREEN_COORD = MVP_MATRIX * modifiedPosition;
	PREV_SCREEN_COORD = PREV_MVP_MATRIX * prevModifiedPosition;
	UNJITERRED_SCREEN_POSITION = SCREEN_COORD;
	SCREEN_COORD.xy += uniCameraJitter * SCREEN_COORD.w;
	gl_Position = SCREEN_COORD;
}