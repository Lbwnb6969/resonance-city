uniform vec2 uniTexelSize;
uniform float uniShaderColorWeight;
uniform vec4 uniformAlbedoColor[MAX_MATERIAL_COUNT];
uniform bool uniShadowStage;
uniform samplerBuffer uniLayerData;
uniform int uniCoreLayerCount;
uniform float uniBlendSmooth;
uniform float uniHeightmapEdgeFading;
uniform isamplerBuffer uniLayerIndexingBuffer;
uniform sampler2DArray uniTerrainLayerMask;
uniform ivec3 uniTerrainLayerMaskSize;
uniform int uniTerrainLayerMaskPaddingWidth;
uniform sampler2DArray uniTextureLayer;
uniform sampler2D uniTextureWorld;
uniform vec2 uniTerrainSize;
uniform vec2 uniTileSize;
uniform vec2 uniTerrainLayerAdd;
in vec3 LOCAL_POSITION;
in vec4 VERTEX_COLOR;
in vec3 NORMAL;
in vec4 PREV_SCREEN_COORD;
in vec4 UNJITERRED_SCREEN_POSITION;
flat in ivec3 TILE_DATA;
layout(location = 0) out vec4 outAlbedoColor;
layout(location = 1) out vec4 outNormal;
layout(location = 2) out vec4 outMotionVector;

void main()
{
	vec3 cpy_NORMAL = normalize(NORMAL);
	uint MATERIAL_ID = uint(0);
	vec4 MATERIAL_ALBEDO = uniformAlbedoColor[MATERIAL_ID];
	vec4 ALBEDO = MATERIAL_ALBEDO * VERTEX_COLOR;
	vec2 previousFrameScreenCoord = PREV_SCREEN_COORD.xy / PREV_SCREEN_COORD.w;
	vec2 currentFrameScreenCoord = UNJITERRED_SCREEN_POSITION.xy / UNJITERRED_SCREEN_POSITION.w;
	vec2 MOTION_VECTOR = (currentFrameScreenCoord - previousFrameScreenCoord) * 0.5 / uniTexelSize;
	if(! uniShadowStage) {
		{
			vec2 uvTerrain = LOCAL_POSITION.xz / vec2(uniTerrainSize.xy);
			vec2 inTileCoord = mod(LOCAL_POSITION.xz, uniTileSize);
			vec2 bleedingTileSize = uniTileSize + vec2(2 * uniTerrainLayerMaskPaddingWidth);
			ivec2 layerMaskTileCount = uniTerrainLayerMaskSize.xy / ivec2(bleedingTileSize);
			float maximumBlendValue = 0.0;
			float averageStaticLayerHeight = 0.0;
			int layerOffset = TILE_DATA.r;
			float layerMaskArray[32];
			vec4 layerColorArray[32];
			int firstDynamicLayer = 0;
			for(int i = 0; i < 0; ++ i)
			{
				ivec2 tileLayerData = texelFetch(uniLayerIndexingBuffer, layerOffset + i).rg;
				int layerId = tileLayerData.r;
				int tileLayerMaskId = tileLayerData.g;
				vec3 tileLayerCoord;
				tileLayerCoord.x = mod(tileLayerMaskId, layerMaskTileCount.x) * bleedingTileSize.x;
				tileLayerCoord.y = mod(tileLayerMaskId / layerMaskTileCount.x, layerMaskTileCount.y) * bleedingTileSize.y;
				tileLayerCoord.z = tileLayerMaskId / (layerMaskTileCount.x * layerMaskTileCount.y);
				tileLayerCoord.xy += vec2(uniTerrainLayerMaskPaddingWidth);
				vec3 uvLayerMask = (tileLayerCoord + vec3(inTileCoord, 0.0)) / vec3(uniTerrainLayerMaskSize.xy, 1.0);
				vec2 layerData = texelFetch(uniLayerData, layerId).xy;
				float tileSize = layerData.x;
				int propertyFlag = floatBitsToInt(layerData.g);
				vec3 uv = LOCAL_POSITION.xyz / tileSize;
				uv.y *= - 1;
				vec3 uvLayer = uv;
				bool _isTriplanar = i < 0;
				int LAYER_PROPERTY_FLAG_APPLY_WORLD_MULT = 0x1;
				vec4 result = vec4(1.0);
				vec3 worldColorFactor = texture(uniTextureWorld, uvTerrain).rgb;
				if(_isTriplanar) {
					{
						vec4 colorXY = texture(uniTextureLayer, vec3(uvLayer.xy, layerId));
						vec4 colorZY = texture(uniTextureLayer, vec3(uvLayer.zy, layerId));
						vec2 normal = normalize(cpy_NORMAL.xz);
						float cos = abs(normal.x);
						float sin = 1 - abs(normal.y);
						float t = (cos + sin) / 2;
						float step = 0.3;
						result = mix(colorXY, colorZY, smoothstep(step, 1 - step, t));
					}
				} else {
					{
						vec4 colorXZ = texture(uniTextureLayer, vec3(uvLayer.xz, layerId));
						result = colorXZ;
					}
				}				if((propertyFlag & LAYER_PROPERTY_FLAG_APPLY_WORLD_MULT) != 0x0) {
					{
						result.rgb = (result.rgb + uniTerrainLayerAdd.x) * (worldColorFactor + uniTerrainLayerAdd.y);
					}
				}
				vec4 terrainSample = result;
				float maskValue = textureLod(uniTerrainLayerMask, uvLayerMask, 0).r;
				layerMaskArray[i] = maskValue;
				terrainSample.a *= min(maskValue / uniHeightmapEdgeFading, 1.0);
				layerColorArray[i] = terrainSample;
				float height = terrainSample.a;
				if(layerId >= uniCoreLayerCount) {
					{
						firstDynamicLayer = min(firstDynamicLayer, i);
					}
				} else {
					{
						maximumBlendValue = max(maximumBlendValue, maskValue + height);
						averageStaticLayerHeight += height;
					}
				}			}
			float blendOffset = maximumBlendValue - uniBlendSmooth;
			averageStaticLayerHeight /= firstDynamicLayer;
			ALBEDO = vec4(0.0, 0.0, 0.0, 1.0);
			float sumBlendWeight = 0.0;
			for(int i_1 = 0; i_1 < firstDynamicLayer; ++ i_1)
			{
				vec4 layerColor = layerColorArray[i_1];
				float blendWeight = max(layerMaskArray[i_1] + layerColor.a - blendOffset, 0.0);
				sumBlendWeight += blendWeight;
				ALBEDO.rgb += layerColor.rgb * blendWeight;
			}
			ALBEDO.rgb /= sumBlendWeight;
			for(int i_2 = firstDynamicLayer; i_2 < 0; ++ i_2)
			{
				vec4 layerColor_1 = layerColorArray[i_2];
				float maskValue2 = layerMaskArray[i_2];
				float maskValue1 = (1.0 - maskValue2);
				float height1 = averageStaticLayerHeight;
				float height2 = layerColor_1.a;
				float blendOffset_1 = max(height1 + maskValue1, height2 + maskValue2) - uniBlendSmooth;
				float blendWeight1 = max(height1 + maskValue1 - blendOffset_1, 0);
				float blendWeight2 = max(height2 + maskValue2 - blendOffset_1, 0);
				ALBEDO.rgb = (ALBEDO.rgb * blendWeight1 + layerColor_1.rgb * blendWeight2) / (blendWeight1 + blendWeight2);
			}
			ALBEDO *= MATERIAL_ALBEDO;
		}
	}
	outAlbedoColor = mix(uniformAlbedoColor[MATERIAL_ID], ALBEDO, uniShaderColorWeight);
	outNormal = vec4(cpy_NORMAL * 0.5 + 0.5, 1.0);
	outMotionVector = vec4(MOTION_VECTOR, 0.0, 1.0);
}