in vec3 attribPosition;
in vec2 attribUv;
in vec4 attribColor;
in vec3 attribNormal;
in vec4 instMatModel0;
in vec4 instMatModel1;
in vec4 instMatModel2;
in vec4 instPrevMatModel0;
in vec4 instPrevMatModel1;
in vec4 instPrevMatModel2;
in uvec4 instDataPacked;
uniform mat4 uniMatViewProjection;
uniform mat4 uniPrevMatViewProjection;
uniform vec3 uniCameraPosition;
uniform float uniVertexColorWeight;
uniform vec2 uniTerrainSize;
uniform vec2 uniPlayableTerrainSize;
uniform sampler2D uniTextureHeightMap;
uniform float uniMinHeight;
uniform float uniMaxHeight;
uniform float uniMaxDistance;
uniform sampler2D uniTextureNormalMap;
uniform sampler2D uniTextureRoadMap;
uniform sampler2DArray uniTextureTerrainLayerMask;
uniform ivec3 uniTerrainLayerMaskSize;
uniform int uniTerrainLayerMaskPaddingWidth;
uniform vec2 uniTileSize;
uniform bool uniWorldMultEnabled;
uniform mat4 uniTerrainInverseMatrix;
uniform isamplerBuffer uniTileDataBuffer;
uniform isamplerBuffer uniLayerIndexingBuffer;
uniform int uniCoreLayerCount;
uniform int uniMaskLayerId;
uniform sampler2D uniTextureWorldColor;
uniform vec2 uniCameraJitter;
flat out uint MATERIAL_ID;
out vec4 INSTANCE_COLOR;
out vec4 VERTEX_COLOR;
out vec3 NORMAL;
out vec2 UV;
out vec4 PREV_SCREEN_COORD;
out vec4 UNJITERRED_SCREEN_POSITION;
out vec3 TERRAIN_POSITION;

void main()
{
	vec3 CAMERA_POSITION = uniCameraPosition;
	VERTEX_COLOR = mix(vec4(1), attribColor, uniVertexColorWeight);
	mat4 MODEL_MATRIX = mat4(instMatModel0.x, instMatModel0.y, instMatModel0.z, 0, instMatModel0.w, instMatModel1.x, instMatModel1.y, 0, instMatModel1.z, instMatModel1.w, instMatModel2.x, 0, instMatModel2.y, instMatModel2.z, instMatModel2.w, 1);
	mat4 PREV_MODEL_MATRIX = mat4(instPrevMatModel0.x, instPrevMatModel0.y, instPrevMatModel0.z, 0, instPrevMatModel0.w, instPrevMatModel1.x, instPrevMatModel1.y, 0, instPrevMatModel1.z, instPrevMatModel1.w, instPrevMatModel2.x, 0, instPrevMatModel2.y, instPrevMatModel2.z, instPrevMatModel2.w, 1);
	MATERIAL_ID = instDataPacked.x;
	INSTANCE_COLOR = vec4((instDataPacked.y & 0x000000ff), (instDataPacked.y & 0x0000ff00) >> 8, (instDataPacked.y & 0x00ff0000) >> 16, (instDataPacked.y & 0xff000000) >> 24) / 255.0;
	mat4 VP_MATRIX = uniMatViewProjection;
	mat4 PREV_VP_MATRIX = uniPrevMatViewProjection;
	mat4 MVP_MATRIX = uniMatViewProjection * MODEL_MATRIX;
	mat4 PREV_MVP_MATRIX = uniPrevMatViewProjection * PREV_MODEL_MATRIX;
	vec3 vertexPosition = attribPosition;
	vec3 prevVertexPosition = vertexPosition;
	vec3 LOCAL_NORMAL = attribNormal;
	UV = attribUv;
	vec3 LOCAL_POSITION = vertexPosition;
	vec3 WORLD_POSITION = ((MODEL_MATRIX) * vec4(LOCAL_POSITION, 1.0)).xyz;
	NORMAL = ((MODEL_MATRIX) * vec4(LOCAL_NORMAL, 0.0)).xyz;
	vec4 SCREEN_COORD = MVP_MATRIX * vec4(vertexPosition, 1.0);
	PREV_SCREEN_COORD = PREV_MVP_MATRIX * vec4(prevVertexPosition, 1.0);
	vec3 worldPosition = (MODEL_MATRIX * vec4(LOCAL_POSITION, 1.0)).xyz;
	vec3 prevWorldPosition = (PREV_MODEL_MATRIX * vec4(LOCAL_POSITION, 1.0)).xyz;
	WORLD_POSITION = worldPosition;
	TERRAIN_POSITION = (uniTerrainInverseMatrix * vec4(worldPosition, 1.0)).xyz;
	vec2 uvTerrain = TERRAIN_POSITION.xz / uniTerrainSize;
	vec2 uvRoad = WORLD_POSITION.xz / uniPlayableTerrainSize;
	float scaleY = length(MODEL_MATRIX[1].xyz);
	float height = uniMinHeight + texture(uniTextureHeightMap, uvTerrain).x * (uniMaxHeight - uniMinHeight);
	worldPosition.y = height + LOCAL_POSITION.y * scaleY;
	prevWorldPosition.y = height + LOCAL_POSITION.y * scaleY;
	vec3 faceNormal = NORMAL;
	vec2 uvNormal = TERRAIN_POSITION.xz / uniTerrainSize;
	NORMAL = (texture(uniTextureNormalMap, uvNormal).rgb - 0.5) * 2;
	float maskSlope = clamp((0.78 - NORMAL.y) / 0.05, 0.0, 1.0);
	worldPosition.y -= maskSlope * 0.8 * scaleY;
	prevWorldPosition.y -= maskSlope * 0.8 * scaleY;
	float distance = length((worldPosition.xyz - CAMERA_POSITION));
	float transition = 40.0;
	float distanceFade = 1.0 - step(uniMaxDistance - transition, distance) * (distance - uniMaxDistance + transition) / transition;
	float faceCamera = max(dot(NORMAL, normalize(CAMERA_POSITION - worldPosition.xyz)) - 0.1, 0.0);
	worldPosition.xz += (faceNormal * (1 - maskSlope) * LOCAL_POSITION.y * (0.5 + faceCamera * 0.3)).xz * distanceFade;
	prevWorldPosition.xz += (faceNormal * (1 - maskSlope) * LOCAL_POSITION.y * (0.5 + faceCamera * 0.3)).xz * distanceFade;
	ivec2 size = textureSize(uniTextureRoadMap, 0);
	vec2 texelSize = 1.0 / vec2(size);
	vec4 gather = textureGather(uniTextureRoadMap, uvRoad + texelSize * 0.5);
	vec2 roadArray[4];
	for(int i = 0; i < 4; ++ i)
	{
		int value = int(gather[i] * 0xff);
		int roadType = (value & 0x80) >> 7;
		float intensity = float(value & 0x7f) / 0x7f;
		roadArray[i] = vec2(intensity * (1 - roadType), intensity * roadType);
	}
	vec2 p0q0 = roadArray[3];
	vec2 p1q0 = roadArray[2];
	vec2 p0q1 = roadArray[0];
	vec2 p1q1 = roadArray[1];
	vec2 f = fract(uvRoad * vec2(size));
	vec2 pInterp_q0 = mix(p0q0, p1q0, f.x);
	vec2 pInterp_q1 = mix(p0q1, p1q1, f.x);
	vec2 roadIntensity2f = mix(pInterp_q0, pInterp_q1, f.y);
	float roadIntensity = max(roadIntensity2f.x, roadIntensity2f.y) * 2.0;
	worldPosition.y -= roadIntensity * scaleY;
	prevWorldPosition.y -= roadIntensity * scaleY;
	float grassIntensity = 0;
	{
		vec2 inTileCoord = mod(TERRAIN_POSITION.xz, uniTileSize);
		vec2 bleedingTileSize = uniTileSize + vec2(2 * uniTerrainLayerMaskPaddingWidth);
		ivec2 layerMaskTileCount = uniTerrainLayerMaskSize.xy / ivec2(bleedingTileSize);
		ivec2 tileCoord = ivec2(floor(TERRAIN_POSITION.xz / uniTileSize));
		int tileCountX = int(ceil(floor(uniTerrainSize.x / uniTileSize.x)));
		int customId = tileCoord.x + tileCoord.y * tileCountX;
		ivec3 tileData = texelFetch(uniTileDataBuffer, customId).xyz;
		int layerOffset = tileData.x;
		int layerCount = tileData.y;
		for(int i_1 = 0; i_1 < layerCount; ++ i_1)
		{
			ivec2 tileLayerData = texelFetch(uniLayerIndexingBuffer, layerOffset + i_1).rg;
			int layer = tileLayerData.r;
			int tileLayerMaskId = tileLayerData.g;
			if(layer == uniMaskLayerId || layer >= uniCoreLayerCount) {
				{
					vec3 tileLayerCoord;
					tileLayerCoord.x = mod(tileLayerMaskId, layerMaskTileCount.x) * bleedingTileSize.x;
					tileLayerCoord.y = mod(tileLayerMaskId / layerMaskTileCount.x, layerMaskTileCount.y) * bleedingTileSize.y;
					tileLayerCoord.z = tileLayerMaskId / (layerMaskTileCount.x * layerMaskTileCount.y);
					tileLayerCoord.xy += vec2(uniTerrainLayerMaskPaddingWidth);
					vec3 uvLayerMask = (tileLayerCoord + vec3(inTileCoord, 0.0)) / vec3(uniTerrainLayerMaskSize.xy, 1.0);
					float layerIntensity = texture(uniTextureTerrainLayerMask, uvLayerMask).r;
					if(layer == uniMaskLayerId) {
						{
							grassIntensity = layerIntensity;
						}
					} else {
						{
							grassIntensity -= layerIntensity;
							grassIntensity = max(0, grassIntensity);
						}
					}				}
			}
		}
	}
	grassIntensity = grassIntensity * 2.0 - 0.25;
	grassIntensity = min(grassIntensity, 1.0);
	float grassReverseIntensity = 1.0 - grassIntensity;
	grassReverseIntensity = grassReverseIntensity * 2.0;
	worldPosition.y -= grassReverseIntensity;
	prevWorldPosition.y -= grassReverseIntensity;
	worldPosition.y -= (1 - distanceFade) * LOCAL_POSITION.y;
	prevWorldPosition.y -= (1 - distanceFade) * LOCAL_POSITION.y;
	SCREEN_COORD = VP_MATRIX * vec4(worldPosition, 1.0);
	PREV_SCREEN_COORD = PREV_VP_MATRIX * vec4(prevWorldPosition, 1.0);
	if(uniWorldMultEnabled) {
		{
			VERTEX_COLOR = vec4(texture(uniTextureWorldColor, uvTerrain).rgb, 1);
		}
	}
	UNJITERRED_SCREEN_POSITION = SCREEN_COORD;
	SCREEN_COORD.xy += uniCameraJitter * SCREEN_COORD.w;
	gl_Position = SCREEN_COORD;
}