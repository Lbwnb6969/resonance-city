uniform mat4 uniViewProjectionInverse;
uniform mat4 uniProjectionInverse;
uniform vec2 uniCameraJitter;
uniform sampler2D uniTextureDepth;
uniform int uniFogType;
uniform vec4 uniFogColor;
uniform float uniFogLinearStart;
uniform float uniFogLinearEnd;
uniform float uniFogExponentialB;
uniform float uniFogLinearHeightStart;
uniform float uniFogLinearHeightEnd;
in vec4 SCREEN_COORD;
layout(location = 0) out vec4 outColor;

void main()
{
	vec2 mUv = SCREEN_COORD.xy * 0.5 / SCREEN_COORD.w + 0.5;
	float DEPTH = texture(uniTextureDepth, mUv).r;
	vec4 screenPosition = vec4(mUv * 2.0 - 1.0, DEPTH * 2.0 - 1.0, 1.0);
	screenPosition.xy -= uniCameraJitter;
	vec4 worldPosition = uniViewProjectionInverse * screenPosition;
	vec3 POSITION = worldPosition.xyz / worldPosition.w;
	vec4 localPosition = uniProjectionInverse * screenPosition;
	localPosition /= localPosition.w;
	float distance = length((localPosition.xyz));
	float fog = 0;
	if(uniFogType == 1) {
		{
			fog = 1 - clamp((uniFogLinearEnd - distance) / (uniFogLinearEnd - uniFogLinearStart), 0, 1);
		}
	} else {
		if(uniFogType == 2) {
			{
				fog = 1 - exp(- distance * uniFogExponentialB);
			}
		} else {
			if(uniFogType == 3) {
				{
					float db = uniFogExponentialB * distance;
					fog = 1 - exp(- db * db);
				}
			}
		}	}	fog *= mix(1, uniFogColor.a, clamp((uniFogLinearEnd - distance) / (uniFogLinearEnd - uniFogLinearStart), 0, 1));
	fog = 1 - (1 - fog) * clamp((uniFogLinearHeightEnd - POSITION.y) / (uniFogLinearHeightEnd - uniFogLinearHeightStart), 0, 1);
	outColor = vec4(uniFogColor.rgb, fog);
}