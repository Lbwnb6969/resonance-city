package terrain
{
	//--------------------
	// STATIC

	static int PATCH_SIZE;

	//--------------------
	// UNIFORMS

	uniform float2 uniPlayableTerrainSize;

	// Roads
	uniform float uniRoadTiling;
	uniform texture2d uniRoadTextureMask;
	uniform texture2d uniRoadDirtTexture;
	uniform texture2d uniRoadDirtBorderTexture;
	uniform texture2d uniRoadPavedTexture;

	// Overlay
	uniform texture2d uniTextureOverlay;

	//--------------------
	// GLOBALS

	global float3 WORLD_POSITION;

	global float4 ALBEDO;

	// Function to get interpolated texel data from a texture with GL_NEAREST property.
	// Bi-Linear interpolation is implemented in this function with the help of nearest four data.
	float2 readRoadBiLinear(float2 _coord)
	{
		int2 size = textureSize(uniRoadTextureMask, 0);
		float2 texelSize = 1.0 / float2(size);

		//float4 gather = textureGather(uniRoadTextureMask, _coord + texelSize * 0.5);
		float4 gather = textureGather(uniRoadTextureMask, floor(_coord * float2(size)) / float2(size) + texelSize * 0.5);
		float2 roadArray[4];

		for (int i = 0; i < 4; ++i)
		{
			int value = int(gather[i] * 0xff);
			int roadType = (value & 0x80) >> 7; // will be 0 or 1
			float intensity = float(value & 0x7f) / 0x7f;
			roadArray[i] = float2(intensity * (1 - roadType), intensity * roadType);
		}

		float2 p0q0 = roadArray[3];
		float2 p1q0 = roadArray[2];

		float2 p0q1 = roadArray[0];
		float2 p1q1 = roadArray[1];

		float2 f = fract(_coord * float2(size)); // Get Interpolation factor.
		float2 pInterp_q0 = mix(p0q0, p1q0, f.x); // Interpolates top row in X direction.
		float2 pInterp_q1 = mix(p0q1, p1q1, f.x); // Interpolates bottom row in X direction.
		return mix(pInterp_q0, pInterp_q1, f.y); // Interpolate in Y direction.
	}

	float3 blend(float4 texture1, float a1, float4 texture2, float a2, float depth)
	{
		float ma = max(texture1.a + a1, texture2.a + a2) - depth;

		float b1 = max(texture1.a + a1 - ma, 0);
		float b2 = max(texture2.a + a2 - ma, 0);

		return (texture1.rgb * b1 + texture2.rgb * b2) / (b1 + b2);
	}

	//--------------------
	// MODULES

	module fragment terrainRoad
	{
		float2 uvRoadMask = WORLD_POSITION.xz / uniPlayableTerrainSize;

		if (uvRoadMask.x >= 0.0 && uvRoadMask.y >= 0.0 && uvRoadMask.x <= 1.0 && uvRoadMask.y <= 1.0)
		{
			float2 maskRoad = readRoadBiLinear(uvRoadMask);
			float roadIntensity = maskRoad.r + maskRoad.g;

			if (roadIntensity > 0)
			{
				float2 uvRoad = WORLD_POSITION.xz / uniRoadTiling;

				float4 colorDirtBorderRoad = texture(uniRoadDirtBorderTexture, uvRoad);

				float4 colorDirtRoad = texture(uniRoadDirtTexture, uvRoad);
				ALBEDO.rgb = mix(ALBEDO.rgb, max(colorDirtBorderRoad.rgb, 0), roadIntensity);

				ALBEDO.a = 0.8;
				ALBEDO.rgb = blend(colorDirtRoad, roadIntensity, ALBEDO, 1 - roadIntensity, 0.2);

				if (maskRoad.g > 0)
				{
					float4 colorPavedRoad = texture(uniRoadPavedTexture, uvRoad);
					ALBEDO.a = 0.9;
					ALBEDO.rgb = blend(colorPavedRoad, maskRoad.g, ALBEDO, 1 - maskRoad.g, 0.2);
				}
			}
		}
	}

	module fragment terrainOverlay
	{
		float2 uvGrid = WORLD_POSITION.xz / uniPlayableTerrainSize;

		float lerpDistance = 50.0; // TODO: expose as uniform
		float2 lerpUvDistance = float2(lerpDistance) / uniPlayableTerrainSize;
		float2 edgeLerpMax = smoothstep(float2(1.0) - lerpUvDistance, float2(1.0), uvGrid);
		float2 edgeLerpMin = smoothstep(lerpUvDistance, float2(0.0), uvGrid);
		float edgeLerp = max(max(edgeLerpMax.x, edgeLerpMax.y), max(edgeLerpMin.x, edgeLerpMin.y));

		float4 overlay = texture(uniTextureOverlay, uvGrid);
		overlay.a = mix(overlay.a, 0.0, edgeLerp);
		ALBEDO.rgb = overlay.rgb * overlay.a + ALBEDO.rgb * (1 - overlay.a);
	}
}
