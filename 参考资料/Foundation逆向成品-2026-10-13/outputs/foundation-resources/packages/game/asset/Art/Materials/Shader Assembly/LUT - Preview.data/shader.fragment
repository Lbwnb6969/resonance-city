uniform vec2 uniTexelSize;
uniform float uniShaderColorWeight;
uniform vec4 uniformAlbedoColor[MAX_MATERIAL_COUNT];
uniform sampler2D instTextureAlbedo[MAX_MATERIAL_COUNT];
uniform sampler2D uniTextureLut;
uniform float uniVertexTintHue;
uniform float uniLutWeight;
uniform float uniVertexColorOrder;
uniform vec3 uniColor;
uniform float uniBlackAndWhite;
uniform float uniAdd;
uniform float uniMult;
flat in uint MATERIAL_ID;
in vec4 INSTANCE_COLOR;
in vec4 VERTEX_COLOR;
in vec3 NORMAL;
in vec2 UV;
in vec4 PREV_SCREEN_COORD;
in vec4 UNJITERRED_SCREEN_POSITION;
layout(location = 0) out vec4 outAlbedoColor;
layout(location = 1) out vec4 outNormal;
layout(location = 2) out vec4 outMotionVector;

void main()
{
	vec3 cpy_NORMAL = normalize(NORMAL);
	vec4 MATERIAL_ALBEDO = uniformAlbedoColor[MATERIAL_ID];
	MATERIAL_ALBEDO *= texture(instTextureAlbedo[MATERIAL_ID], UV);
	vec4 ALBEDO = MATERIAL_ALBEDO * VERTEX_COLOR;
	ALBEDO *= INSTANCE_COLOR;
	vec2 previousFrameScreenCoord = PREV_SCREEN_COORD.xy / PREV_SCREEN_COORD.w;
	vec2 currentFrameScreenCoord = UNJITERRED_SCREEN_POSITION.xy / UNJITERRED_SCREEN_POSITION.w;
	vec2 MOTION_VECTOR = (currentFrameScreenCoord - previousFrameScreenCoord) * 0.5 / uniTexelSize;
	vec3 gammaVertex = pow(VERTEX_COLOR.rgb, vec3(1 / 2.2));
	vec4 K = vec4(0.0, - 1.0 / 3.0, 2.0 / 3.0, - 1.0);
	vec4 p = mix(vec4(gammaVertex.bg, K.wz), vec4(gammaVertex.gb, K.xy), step(gammaVertex.b, gammaVertex.g));
	vec4 q = mix(vec4(p.xyw, gammaVertex.r), vec4(gammaVertex.r, p.yzx), step(p.x, gammaVertex.r));
	float d = q.x - min(q.w, q.y);
	float e = 0.000000001;
	vec3 hsvVertex = vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
	hsvVertex.x = uniVertexTintHue / 365.0;
	vec4 inputAlbedo = mix(ALBEDO, MATERIAL_ALBEDO * INSTANCE_COLOR, uniVertexColorOrder);
	vec4 gammaAlbedo = pow(inputAlbedo, vec4(1 / 2.2, 1 / 2.2, 1 / 2.2, 1.0));
	vec2 uvLut = (gammaAlbedo.rg * 15.0 + 0.5) / 16.0;
	uvLut.x /= 16.0;
	float blueOffset = floor(gammaAlbedo.b * 15.0);
	float w = gammaAlbedo.b * 15.0 - blueOffset;
	vec4 resultColor = vec4(textureLod(uniTextureLut, vec2(uvLut.x + blueOffset / 16.0, uvLut.y), 0).rgb * (1 - w), gammaAlbedo.a);
	resultColor.rgb += textureLod(uniTextureLut, vec2(uvLut.x + min(blueOffset + 1.0, 15.0) / 16.0, uvLut.y), 0).rgb * w;
	vec4 albedoLut = resultColor;
	vec4 K_1 = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
	vec3 p_1 = abs(fract(hsvVertex.xxx + K_1.xyz) * 6.0 - K_1.www);
	albedoLut = mix(albedoLut, albedoLut * vec4(pow(hsvVertex.z * mix(K_1.xxx, clamp(p_1 - K_1.xxx, 0.0, 1.0), hsvVertex.y), vec3(2.2)), 1), uniVertexColorOrder);
	ALBEDO = mix(ALBEDO, albedoLut, uniLutWeight);
	float w_1 = 0.9;
	vec3 blue = vec3(w_1);
	vec3 bw = mix(ALBEDO.rgb, vec3(ALBEDO.r * 0.3 + ALBEDO.g * 0.59 + ALBEDO.b * 0.11), uniBlackAndWhite);
	bw += uniAdd;
	bw *= uniMult;
	bw = max(bw, vec3(0.1));
	bw = min(bw, vec3(0.5));
	ALBEDO = vec4((blue * bw + ALBEDO.rgb * (1 - w_1)) * uniColor, 1);
	outAlbedoColor = mix(uniformAlbedoColor[MATERIAL_ID], ALBEDO, uniShaderColorWeight);
	outNormal = vec4(cpy_NORMAL * 0.5 + 0.5, 1.0);
	outMotionVector = vec4(MOTION_VECTOR, 0.0, 1.0);
}