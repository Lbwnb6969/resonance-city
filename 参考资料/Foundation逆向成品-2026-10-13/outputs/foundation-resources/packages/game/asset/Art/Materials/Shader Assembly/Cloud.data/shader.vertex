in vec3 attribPosition;
in vec2 attribUv;
in vec4 attribColor;
in vec3 attribNormal;
in vec4 instMatModel0;
in vec4 instMatModel1;
in vec4 instMatModel2;
in vec4 instPrevMatModel0;
in vec4 instPrevMatModel1;
in vec4 instPrevMatModel2;
in uvec4 instDataPacked;
uniform mat4 uniMatViewProjection;
uniform mat4 uniPrevMatViewProjection;
uniform float uniVertexColorWeight;
uniform vec2 uniCameraJitter;
flat out uint MATERIAL_ID;
out vec4 INSTANCE_COLOR;
out vec4 VERTEX_COLOR;
out vec3 NORMAL;
out vec2 UV;
out vec4 PREV_SCREEN_COORD;
out vec4 UNJITERRED_SCREEN_POSITION;

void main()
{
	VERTEX_COLOR = mix(vec4(1), attribColor, uniVertexColorWeight);
	mat4 MODEL_MATRIX = mat4(instMatModel0.x, instMatModel0.y, instMatModel0.z, 0, instMatModel0.w, instMatModel1.x, instMatModel1.y, 0, instMatModel1.z, instMatModel1.w, instMatModel2.x, 0, instMatModel2.y, instMatModel2.z, instMatModel2.w, 1);
	mat4 PREV_MODEL_MATRIX = mat4(instPrevMatModel0.x, instPrevMatModel0.y, instPrevMatModel0.z, 0, instPrevMatModel0.w, instPrevMatModel1.x, instPrevMatModel1.y, 0, instPrevMatModel1.z, instPrevMatModel1.w, instPrevMatModel2.x, 0, instPrevMatModel2.y, instPrevMatModel2.z, instPrevMatModel2.w, 1);
	MATERIAL_ID = instDataPacked.x;
	INSTANCE_COLOR = vec4((instDataPacked.y & 0x000000ff), (instDataPacked.y & 0x0000ff00) >> 8, (instDataPacked.y & 0x00ff0000) >> 16, (instDataPacked.y & 0xff000000) >> 24) / 255.0;
	mat4 MVP_MATRIX = uniMatViewProjection * MODEL_MATRIX;
	mat4 PREV_MVP_MATRIX = uniPrevMatViewProjection * PREV_MODEL_MATRIX;
	vec3 vertexPosition = attribPosition;
	vec3 prevVertexPosition = vertexPosition;
	vec3 LOCAL_NORMAL = attribNormal;
	UV = attribUv;
	NORMAL = ((MODEL_MATRIX) * vec4(LOCAL_NORMAL, 0.0)).xyz;
	vec4 SCREEN_COORD = MVP_MATRIX * vec4(vertexPosition, 1.0);
	PREV_SCREEN_COORD = PREV_MVP_MATRIX * vec4(prevVertexPosition, 1.0);
	gl_Position = gl_Position.xyww;
	UNJITERRED_SCREEN_POSITION = SCREEN_COORD;
	SCREEN_COORD.xy += uniCameraJitter * SCREEN_COORD.w;
	gl_Position = SCREEN_COORD;
}