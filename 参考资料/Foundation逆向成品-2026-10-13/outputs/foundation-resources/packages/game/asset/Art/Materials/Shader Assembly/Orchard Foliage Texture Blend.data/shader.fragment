uniform vec2 uniTexelSize;
uniform float uniShaderColorWeight;
uniform vec4 uniformAlbedoColor[MAX_MATERIAL_COUNT];
uniform sampler2D uniTextureA;
uniform sampler2D uniTextureB;
uniform sampler2D uniNoiseTexture;
uniform float uniBlend;
uniform float uniNoiseTiling;
uniform float uniEdgeSoftness;
uniform float uniAlphaThreshold;
flat in uint MATERIAL_ID;
in vec4 INSTANCE_COLOR;
in vec4 VERTEX_COLOR;
in vec3 NORMAL;
in vec2 UV;
in vec4 PREV_SCREEN_COORD;
in vec4 UNJITERRED_SCREEN_POSITION;
layout(location = 0) out vec4 outAlbedoColor;
layout(location = 1) out vec4 outNormal;
layout(location = 2) out vec4 outMotionVector;

void main()
{
	vec3 cpy_NORMAL = normalize(NORMAL);
	vec4 MATERIAL_ALBEDO = uniformAlbedoColor[MATERIAL_ID];
	vec4 ALBEDO = MATERIAL_ALBEDO * VERTEX_COLOR;
	ALBEDO *= INSTANCE_COLOR;
	vec2 previousFrameScreenCoord = PREV_SCREEN_COORD.xy / PREV_SCREEN_COORD.w;
	vec2 currentFrameScreenCoord = UNJITERRED_SCREEN_POSITION.xy / UNJITERRED_SCREEN_POSITION.w;
	vec2 MOTION_VECTOR = (currentFrameScreenCoord - previousFrameScreenCoord) * 0.5 / uniTexelSize;
	vec4 albedo1 = texture(uniTextureA, UV);
	vec4 albedo2 = texture(uniTextureB, UV);
	float noise = texture(uniNoiseTexture, UV * uniNoiseTiling).r;
	float softness = max(uniEdgeSoftness, 0.0001);
	float threshold = uniBlend * (1.0 + softness);
	float t = clamp((threshold - noise) / softness, 0.0, 1.0);
	t = t * t * (3.0 - 2.0 * t);
	vec4 result = albedo1 * (1.0 - t) + albedo2 * t;
	ALBEDO = ALBEDO * result;
	if(ALBEDO.a < uniAlphaThreshold) {
		{
			discard;
		}
	}
	outAlbedoColor = mix(uniformAlbedoColor[MATERIAL_ID], ALBEDO, uniShaderColorWeight);
	outNormal = vec4(cpy_NORMAL * 0.5 + 0.5, 1.0);
	outMotionVector = vec4(MOTION_VECTOR, 0.0, 1.0);
}