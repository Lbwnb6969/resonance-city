in vec3 attribPosition;
in vec2 attribUv;
in vec4 attribColor;
in vec3 attribNormal;
in vec4 instMatModel0;
in vec4 instMatModel1;
in vec4 instMatModel2;
in vec4 instPrevMatModel0;
in vec4 instPrevMatModel1;
in vec4 instPrevMatModel2;
in uvec4 instDataPacked;
uniform mat4 uniMatViewProjection;
uniform mat4 uniPrevMatViewProjection;
uniform float uniVertexColorWeight;
uniform float uniStepProgress;
uniform float uniFruitGrowDelay;
uniform float uniFruitGrowDuration;
uniform float uniFruitSparsity;
uniform float uniFruitRipeningDelay;
uniform float uniFruitRipeningDuration;
uniform float uniWindTime;
uniform float uniPrevWindTime;
uniform vec2 uniCameraJitter;
flat out uint MATERIAL_ID;
out vec4 INSTANCE_COLOR;
out vec4 VERTEX_COLOR;
out vec3 NORMAL;
out vec2 UV;
out vec4 PREV_SCREEN_COORD;
out vec4 UNJITERRED_SCREEN_POSITION;
out float entityRandomOffset;
out float fruitRipeness;

void main()
{
	VERTEX_COLOR = mix(vec4(1), attribColor, uniVertexColorWeight);
	mat4 MODEL_MATRIX = mat4(instMatModel0.x, instMatModel0.y, instMatModel0.z, 0, instMatModel0.w, instMatModel1.x, instMatModel1.y, 0, instMatModel1.z, instMatModel1.w, instMatModel2.x, 0, instMatModel2.y, instMatModel2.z, instMatModel2.w, 1);
	mat4 PREV_MODEL_MATRIX = mat4(instPrevMatModel0.x, instPrevMatModel0.y, instPrevMatModel0.z, 0, instPrevMatModel0.w, instPrevMatModel1.x, instPrevMatModel1.y, 0, instPrevMatModel1.z, instPrevMatModel1.w, instPrevMatModel2.x, 0, instPrevMatModel2.y, instPrevMatModel2.z, instPrevMatModel2.w, 1);
	MATERIAL_ID = instDataPacked.x;
	INSTANCE_COLOR = vec4((instDataPacked.y & 0x000000ff), (instDataPacked.y & 0x0000ff00) >> 8, (instDataPacked.y & 0x00ff0000) >> 16, (instDataPacked.y & 0xff000000) >> 24) / 255.0;
	mat4 VP_MATRIX = uniMatViewProjection;
	mat4 PREV_VP_MATRIX = uniPrevMatViewProjection;
	mat4 MVP_MATRIX = uniMatViewProjection * MODEL_MATRIX;
	mat4 PREV_MVP_MATRIX = uniPrevMatViewProjection * PREV_MODEL_MATRIX;
	vec3 vertexPosition = attribPosition;
	vec3 prevVertexPosition = vertexPosition;
	vec3 LOCAL_NORMAL = attribNormal;
	UV = attribUv;
	vec3 LOCAL_POSITION = vertexPosition;
	vec3 PREV_LOCAL_POSITION = prevVertexPosition;
	vec3 WORLD_POSITION = ((MODEL_MATRIX) * vec4(LOCAL_POSITION, 1.0)).xyz;
	vec3 PREV_WORLD_POSITION = ((PREV_MODEL_MATRIX) * vec4(PREV_LOCAL_POSITION, 1.0)).xyz;
	NORMAL = ((MODEL_MATRIX) * vec4(LOCAL_NORMAL, 0.0)).xyz;
	vec4 SCREEN_COORD = MVP_MATRIX * vec4(vertexPosition, 1.0);
	PREV_SCREEN_COORD = PREV_MVP_MATRIX * vec4(prevVertexPosition, 1.0);
	uint entityId = 0u;
	entityRandomOffset = 0;
	float timeOffset = 0;
	vec3 localOffset = vec3(0);
	vec3 localPivot = vec3(0);
	float fruitScale = 0;
	if(VERTEX_COLOR.a < 0.999) {
		{
			vec3 worldPosition = MODEL_MATRIX[3].xyz;
			vec3 t = worldPosition;
			uint s = floatBitsToInt(t.x) ^ (floatBitsToInt(t.y) * 1664525u) ^ (floatBitsToInt(t.z) * 1013904223u);
			uint uniqueObjectId = s;
			uint id = uint(VERTEX_COLOR.a * 0xff);
			uint a = (uniqueObjectId | 1u);
			uint b = (uniqueObjectId >> 8) & 0xffu;
			entityId = (a * id + b) & 0xffu;
			vec3 worldPosition_1 = MODEL_MATRIX[3].xyz;
			vec3 p = fract(worldPosition_1 * 0.1031);
			p += dot(p, p.yzx + 33.33);
			entityRandomOffset = fract((p.x + p.y) * p.z);
			timeOffset = ((entityId) / 255.0);
			localOffset = VERTEX_COLOR.xzy - 0.5;
			localPivot = LOCAL_POSITION - localOffset;
			fruitScale = clamp((uniStepProgress - timeOffset * uniFruitSparsity - uniFruitGrowDelay) / uniFruitGrowDuration, 0, 1);
			fruitRipeness = clamp((uniStepProgress - timeOffset * uniFruitSparsity - uniFruitRipeningDelay) / uniFruitRipeningDuration, 0, 1);
		}
	}
	if(VERTEX_COLOR.a < 0.999) {
		{
			LOCAL_POSITION = (localPivot + localOffset * fruitScale);
			PREV_LOCAL_POSITION = LOCAL_POSITION;
			WORLD_POSITION = ((MODEL_MATRIX) * vec4(LOCAL_POSITION, 1.0)).xyz;
			PREV_WORLD_POSITION = ((PREV_MODEL_MATRIX) * vec4(PREV_LOCAL_POSITION, 1.0)).xyz;
			SCREEN_COORD = MVP_MATRIX * vec4(LOCAL_POSITION, 1.0);
			PREV_SCREEN_COORD = PREV_MVP_MATRIX * vec4(PREV_LOCAL_POSITION, 1.0);
		}
	}
	float speed = 1;
	float xoff = 0.5 + sin(uniWindTime * speed * 0.2 + WORLD_POSITION.z * 0.1) * 0.5;
	float yoff = 0.5 + cos(uniWindTime * speed * 0.2 * 5 + WORLD_POSITION.x * 0.1) * 0.5;
	vec2 windDirection = vec2(xoff, yoff);
	float prev_xoff = 0.5 + sin(uniPrevWindTime * speed * 0.2 + PREV_WORLD_POSITION.z * 0.1) * 0.5;
	float prev_yoff = 0.5 + cos(uniPrevWindTime * speed * 0.2 * 5 + PREV_WORLD_POSITION.x * 0.1) * 0.5;
	vec2 prev_windDirection = vec2(prev_xoff, prev_yoff);
	float fBendScale = 0.02;
	float windStrength = length(windDirection);
	float prev_windStrength = length(prev_windDirection);
	vec3 localPosition = ((MODEL_MATRIX) * vec4(LOCAL_POSITION, 0.0)).xyz;
	vec3 prev_localPosition = ((PREV_MODEL_MATRIX) * vec4(PREV_LOCAL_POSITION, 0.0)).xyz;
	float fLength = length(localPosition);
	float fBF = localPosition.y * fBendScale;
	fBF += 1.0;
	fBF *= fBF;
	fBF = fBF * fBF - fBF;
	vec3 vNewPos = localPosition;
	vNewPos.xz += windDirection.xy * fBF;
	localPosition = normalize(vNewPos) * fLength;
	float fLength_1 = length(prev_localPosition);
	float fBF_1 = prev_localPosition.y * fBendScale;
	fBF_1 += 1.0;
	fBF_1 *= fBF_1;
	fBF_1 = fBF_1 * fBF_1 - fBF_1;
	vec3 vNewPos_1 = prev_localPosition;
	vNewPos_1.xz += prev_windDirection.xy * fBF_1;
	prev_localPosition = normalize(vNewPos_1) * fLength_1;
	WORLD_POSITION = localPosition + MODEL_MATRIX[3].xyz;
	PREV_WORLD_POSITION = prev_localPosition + PREV_MODEL_MATRIX[3].xyz;
	vec3 objectPosition = MODEL_MATRIX[3].xyz;
	vec3 prev_objectPosition = PREV_MODEL_MATRIX[3].xyz;
	float BranchAmplitude = 0.02;
	float DetailAmplitude = 0.0;
	vec4 color = VERTEX_COLOR;
	float fDetailPhase = 0.0;
	float fBranchPhase = color.g;
	float fEdgeAtten = 1.0 - color.r;
	float fBranchAtten = 1.0 - color.b;
	float fSpeed = 2.0;
	float fDetailFreq = 0.3;
	float fDetailAmp = DetailAmplitude * windStrength;
	float fTime = uniWindTime * speed;
	float fBranchAmp = BranchAmplitude * windStrength;
	float SIDE_TO_SIDE_FREQ1 = 1.975 * 10;
	float SIDE_TO_SIDE_FREQ2 = 0.793;
	float UP_AND_DOWN_FREQ1 = 0.375;
	float UP_AND_DOWN_FREQ2 = 0.193;
	float fObjPhase = dot(objectPosition, vec3(1));
	float fBranchPhase_1 = fBranchPhase + fObjPhase;
	float fVtxPhase = dot(WORLD_POSITION, vec3(fDetailPhase + fBranchPhase_1));
	vec2 vWavesIn = vec2(fTime) + vec2(fVtxPhase, fBranchPhase_1);
	vec4 vWaves = (fract(vWavesIn.xxyy * vec4(SIDE_TO_SIDE_FREQ1, SIDE_TO_SIDE_FREQ2, UP_AND_DOWN_FREQ1, UP_AND_DOWN_FREQ2)) * 2.0 - 1.0) * fSpeed * fDetailFreq;
	vec4 x = abs(fract(vWaves + 0.5) * 2.0 - 1.0);
	vWaves = x * x * (3.0 - 2.0 * x);
	vec2 vWavesSum = vWaves.xz + vWaves.yw;
	vec3 vPos = WORLD_POSITION + vWavesSum.x * vec3(fEdgeAtten * fDetailAmp * NORMAL);
	vPos.y += vWavesSum.y * fBranchAtten * fBranchAmp;
	WORLD_POSITION = vPos;
	float fTime_1 = uniPrevWindTime * speed;
	float fBranchAmp_1 = BranchAmplitude * prev_windStrength;
	float SIDE_TO_SIDE_FREQ1_1 = 1.975 * 10;
	float SIDE_TO_SIDE_FREQ2_1 = 0.793;
	float UP_AND_DOWN_FREQ1_1 = 0.375;
	float UP_AND_DOWN_FREQ2_1 = 0.193;
	float fObjPhase_1 = dot(prev_objectPosition, vec3(1));
	float fBranchPhase_2 = fBranchPhase + fObjPhase_1;
	float fVtxPhase_1 = dot(PREV_WORLD_POSITION, vec3(fDetailPhase + fBranchPhase_2));
	vec2 vWavesIn_1 = vec2(fTime_1) + vec2(fVtxPhase_1, fBranchPhase_2);
	vec4 vWaves_1 = (fract(vWavesIn_1.xxyy * vec4(SIDE_TO_SIDE_FREQ1_1, SIDE_TO_SIDE_FREQ2_1, UP_AND_DOWN_FREQ1_1, UP_AND_DOWN_FREQ2_1)) * 2.0 - 1.0) * fSpeed * fDetailFreq;
	vec4 x_1 = abs(fract(vWaves_1 + 0.5) * 2.0 - 1.0);
	vWaves_1 = x_1 * x_1 * (3.0 - 2.0 * x_1);
	vec2 vWavesSum_1 = vWaves_1.xz + vWaves_1.yw;
	vec3 vPos_1 = PREV_WORLD_POSITION + vWavesSum_1.x * vec3(fEdgeAtten * fDetailAmp * NORMAL);
	vPos_1.y += vWavesSum_1.y * fBranchAtten * fBranchAmp_1;
	PREV_WORLD_POSITION = vPos_1;
	SCREEN_COORD = VP_MATRIX * vec4(WORLD_POSITION, 1.0);
	PREV_SCREEN_COORD = PREV_VP_MATRIX * vec4(PREV_WORLD_POSITION, 1.0);
	UNJITERRED_SCREEN_POSITION = SCREEN_COORD;
	SCREEN_COORD.xy += uniCameraJitter * SCREEN_COORD.w;
	gl_Position = SCREEN_COORD;
}