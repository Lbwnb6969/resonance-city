in vec3 attribPosition;
in vec2 attribUv;
in vec4 attribColor;
in vec3 attribNormal;
in vec4 instMatModel0;
in vec4 instMatModel1;
in vec4 instMatModel2;
in vec4 instPrevMatModel0;
in vec4 instPrevMatModel1;
in vec4 instPrevMatModel2;
in uvec4 instDataPacked;
uniform mat4 uniMatViewProjection;
uniform mat4 uniPrevMatViewProjection;
uniform float uniVertexColorWeight;
uniform float uniTime;
uniform float uniPrevTime;
uniform vec2 uniCameraJitter;
flat out uint MATERIAL_ID;
out vec4 INSTANCE_COLOR;
out vec4 VERTEX_COLOR;
out vec3 NORMAL;
out vec2 UV;
out vec4 PREV_SCREEN_COORD;
out vec4 UNJITERRED_SCREEN_POSITION;

void main()
{
	VERTEX_COLOR = mix(vec4(1), attribColor, uniVertexColorWeight);
	mat4 MODEL_MATRIX = mat4(instMatModel0.x, instMatModel0.y, instMatModel0.z, 0, instMatModel0.w, instMatModel1.x, instMatModel1.y, 0, instMatModel1.z, instMatModel1.w, instMatModel2.x, 0, instMatModel2.y, instMatModel2.z, instMatModel2.w, 1);
	mat4 PREV_MODEL_MATRIX = mat4(instPrevMatModel0.x, instPrevMatModel0.y, instPrevMatModel0.z, 0, instPrevMatModel0.w, instPrevMatModel1.x, instPrevMatModel1.y, 0, instPrevMatModel1.z, instPrevMatModel1.w, instPrevMatModel2.x, 0, instPrevMatModel2.y, instPrevMatModel2.z, instPrevMatModel2.w, 1);
	MATERIAL_ID = instDataPacked.x;
	INSTANCE_COLOR = vec4((instDataPacked.y & 0x000000ff), (instDataPacked.y & 0x0000ff00) >> 8, (instDataPacked.y & 0x00ff0000) >> 16, (instDataPacked.y & 0xff000000) >> 24) / 255.0;
	mat4 VP_MATRIX = uniMatViewProjection;
	mat4 PREV_VP_MATRIX = uniPrevMatViewProjection;
	mat4 MVP_MATRIX = uniMatViewProjection * MODEL_MATRIX;
	mat4 PREV_MVP_MATRIX = uniPrevMatViewProjection * PREV_MODEL_MATRIX;
	vec3 vertexPosition = attribPosition;
	vec3 prevVertexPosition = vertexPosition;
	vec3 LOCAL_NORMAL = attribNormal;
	UV = attribUv;
	vec3 LOCAL_POSITION = vertexPosition;
	vec3 PREV_LOCAL_POSITION = prevVertexPosition;
	NORMAL = ((MODEL_MATRIX) * vec4(LOCAL_NORMAL, 0.0)).xyz;
	vec4 SCREEN_COORD = MVP_MATRIX * vec4(vertexPosition, 1.0);
	PREV_SCREEN_COORD = PREV_MVP_MATRIX * vec4(prevVertexPosition, 1.0);
	vec4 originalWorld = MODEL_MATRIX * vec4(LOCAL_POSITION, 1.0);
	float xoff = 0.5 + sin(uniTime * 10.2 + originalWorld.z * 11.1) * 0.5;
	float yoff = 0.5 + cos(uniTime * 0.5 * 15.0 + originalWorld.x * 10.1) * 0.5;
	vec2 windDirection = vec2(xoff, yoff);
	float bendScale = 0.12;
	float windStrength = length(windDirection);
	vec3 bentPosition = (MODEL_MATRIX * vec4(LOCAL_POSITION, 0.0)).xyz;
	float positionLength = length(bentPosition);
	float bendFactor = bentPosition.y * bendScale;
	bendFactor += 1.0;
	bendFactor *= bendFactor;
	bendFactor = bendFactor * bendFactor - bendFactor;
	vec3 newPosition = bentPosition;
	newPosition.xz += windDirection.xy * bendFactor;
	bentPosition = normalize(newPosition) * positionLength;
	vec3 objectPosition = (MODEL_MATRIX * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
	vec4 world_1 = vec4(bentPosition + objectPosition, 1.0);
	float branchPhase = VERTEX_COLOR.g + dot(objectPosition, vec3(1.0));
	float branchAtten = 1.0 - VERTEX_COLOR.b;
	float x = (fract((uniTime + branchPhase) * 0.375) * 2.0 - 1.0) * 20.0;
	float x_1 = abs(fract(x + 0.5) * 2.0 - 1.0);
	float waveA = x_1 * x_1 * (3.0 - 2.0 * x_1);
	float x_2 = (fract((uniTime + branchPhase) * 0.193) * 2.0 - 1.0) * 20.0;
	float x_3 = abs(fract(x_2 + 0.5) * 2.0 - 1.0);
	float waveB = x_3 * x_3 * (3.0 - 2.0 * x_3);
	float waveSum = waveA + waveB;
	world_1.y += waveSum * branchAtten * (0.12 * windStrength);
	vec4 world = world_1;
	vec4 originalWorld_1 = PREV_MODEL_MATRIX * vec4(PREV_LOCAL_POSITION, 1.0);
	float xoff_1 = 0.5 + sin(uniPrevTime * 10.2 + originalWorld_1.z * 11.1) * 0.5;
	float yoff_1 = 0.5 + cos(uniPrevTime * 0.5 * 15.0 + originalWorld_1.x * 10.1) * 0.5;
	vec2 windDirection_1 = vec2(xoff_1, yoff_1);
	float bendScale_1 = 0.12;
	float windStrength_1 = length(windDirection_1);
	vec3 bentPosition_1 = (PREV_MODEL_MATRIX * vec4(PREV_LOCAL_POSITION, 0.0)).xyz;
	float positionLength_1 = length(bentPosition_1);
	float bendFactor_1 = bentPosition_1.y * bendScale_1;
	bendFactor_1 += 1.0;
	bendFactor_1 *= bendFactor_1;
	bendFactor_1 = bendFactor_1 * bendFactor_1 - bendFactor_1;
	vec3 newPosition_1 = bentPosition_1;
	newPosition_1.xz += windDirection_1.xy * bendFactor_1;
	bentPosition_1 = normalize(newPosition_1) * positionLength_1;
	vec3 objectPosition_1 = (PREV_MODEL_MATRIX * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
	vec4 world_2 = vec4(bentPosition_1 + objectPosition_1, 1.0);
	float branchPhase_1 = VERTEX_COLOR.g + dot(objectPosition_1, vec3(1.0));
	float branchAtten_1 = 1.0 - VERTEX_COLOR.b;
	float x_4 = (fract((uniPrevTime + branchPhase_1) * 0.375) * 2.0 - 1.0) * 20.0;
	float x_5 = abs(fract(x_4 + 0.5) * 2.0 - 1.0);
	float waveA_1 = x_5 * x_5 * (3.0 - 2.0 * x_5);
	float x_6 = (fract((uniPrevTime + branchPhase_1) * 0.193) * 2.0 - 1.0) * 20.0;
	float x_7 = abs(fract(x_6 + 0.5) * 2.0 - 1.0);
	float waveB_1 = x_7 * x_7 * (3.0 - 2.0 * x_7);
	float waveSum_1 = waveA_1 + waveB_1;
	world_2.y += waveSum_1 * branchAtten_1 * (0.12 * windStrength_1);
	vec4 prevWorld = world_2;
	SCREEN_COORD = VP_MATRIX * world;
	PREV_SCREEN_COORD = PREV_VP_MATRIX * prevWorld;
	UNJITERRED_SCREEN_POSITION = SCREEN_COORD;
	SCREEN_COORD.xy += uniCameraJitter * SCREEN_COORD.w;
	gl_Position = SCREEN_COORD;
}